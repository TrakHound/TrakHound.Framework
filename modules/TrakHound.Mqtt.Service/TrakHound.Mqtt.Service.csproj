<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(TrakHoundTargetFramework)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="trakhound.package.publish.json" Condition="Exists('trakhound.package.publish.json')">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MQTTnet" Version="4.3.7.1207" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TrakHound.Mqtt.Service.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\libraries\TrakHound.Common\TrakHound.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md" TargetPath="Readme.md">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
