<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(TrakHoundTargetFramework)</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- CRON parser shared with the Scheduled Task Worker (to validate imported Schedules) -->
		<Compile Include="..\TrakHound.ScheduledTasks.Worker\Cron\*.cs" Link="Cron\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TrakHound.ScheduledTasks.Api.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\debug\TrakHound.Debug.AspNetCore\TrakHound.Debug.AspNetCore.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="trakhound.package.json" />
	  <None Include="trakhound.package.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
