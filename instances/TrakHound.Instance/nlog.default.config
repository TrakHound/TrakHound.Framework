<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog-AspNetCore.txt">

	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- the targets to write to -->
	<targets>

		<!--Console (the readable Logger Name is the 'name' property, as ${logger} is the Logger ID used for the Log File directory)-->
		<target name="logconsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
			layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}  ${pad:padding=-5:inner=${level:uppercase=true}}  [${event-properties:item=name:whenEmpty=${logger:shortName=true}}]  ${message}${onexception:${newline}${exception:format=tostring}}">
			<highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
			<highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
			<highlight-row condition="level == LogLevel.Fatal" foregroundColor="White" backgroundColor="DarkRed" />
			<highlight-word regex="^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}" foregroundColor="DarkGray" />
			<highlight-word regex="\[[^\]]+\]" foregroundColor="DarkCyan" />
		</target>

		<!--
		Log History (queried by the Explorer and the Logs API) is written by the Instance itself and
		configured in logs.config.yaml (provider, path, minimum level, retention and archive mode).
		Add other targets here to also send logs elsewhere.
		-->

	</targets>

	<!-- rules to map from logger name to target -->
	<rules>

		<!--Write to Console-->
		<logger name="TrakHound.*" minlevel="Info" writeTo="logconsole" />

	</rules>
</nlog>