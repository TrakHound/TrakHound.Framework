    private static bool CanRemoveColumn(BoardColumn column, int taskCount) => column.Saved && taskCount == 0;

    private static string GetRemoveColumnTitle(BoardColumn column, int taskCount)
    {
        if (taskCount > 0) return $"Can't remove : {taskCount} Scheduled Task{(taskCount > 1 ? "s use" : " uses")} this column (move or delete {(taskCount > 1 ? "them" : "it")} first)";
