    #region "Worker Status"

    /// <summary>
    /// Called by the WorkerStatusPanel (on the Renderer's context) after each poll
    /// </summary>
    private void LiveTasksUpdated(Dictionary<string, ScheduledTaskStatus> tasks)
    {
        liveTasks = tasks ?? new Dictionary<string, ScheduledTaskStatus>();
        RenderBoardIfLiveChanged();
    }

    private void RenderBoard()
    {
        renderedLiveSignature = GetLiveSignature();
        StateHasChanged();
    }

    private void RenderBoardIfLiveChanged()
    {
        if (GetLiveSignature() != renderedLiveSignature) RenderBoard();
    }

    /// <summary>
    /// The live state and time based text the cards show (as rendered in the Template), to tell when the board needs to re-render
    /// </summary>
    private string GetLiveSignature()
    {
        var boardItems = items;
        if (boardItems == null) return null;

        var signature = new System.Text.StringBuilder();
        foreach (var item in boardItems)
        {
            var task = item.Task;
            if (task == null) continue;

            signature.Append(task.Id).Append('|');
            if (task.Enabled) signature.Append(FormatRelative(task.NextRun));

            var live = GetLiveStatus(task.Id);
            if (live != null && (live.Running > 0 || live.Waiting > 0 || live.SkippedCount + live.DroppedCount > 0))
            {
                if (live.Running > 0) signature.Append("|r").Append(FormatTimestamp(live.RunStarted)).Append(FormatElapsed(live.RunStarted));
                else if (live.Waiting > 0) signature.Append("|w").Append(FormatElapsed(live.WaitingSince));
                signature.Append("|s").Append(live.SkippedCount).Append(',').Append(live.DroppedCount);
            }

            signature.Append(';');
        }
        return signature.ToString();
    }

    private ScheduledTaskStatus GetLiveStatus(string taskId) => taskId != null ? liveTasks.GetValueOrDefault(taskId) : null;

    /// <summary>
    /// Time since a Timestamp (ex. "12s", "3m 05s")
    /// </summary>
    private static string FormatElapsed(DateTime? since)
    {
        if (since == null) return null;

        var elapsed = DateTime.UtcNow - since.Value.ToUniversalTime();
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        if (elapsed.TotalHours >= 1) return $"{(int)elapsed.TotalHours}h {elapsed.Minutes:00}m";
        if (elapsed.TotalMinutes >= 1) return $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds:00}s";
        return $"{(int)elapsed.TotalSeconds}s";
    }

    #endregion

    #region "Helpers"

    private static string NormalizeSchedule(string schedule)
    {
        return string.Join(' ', (schedule ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }

    /// <summary>
    /// The column of a Schedule : the normalized Schedule (or the Schedule it's an alias of)
    /// </summary>
    private static string GetColumnKey(string schedule)
    {
        var normalized = NormalizeSchedule(schedule);
        return _scheduleAliases.GetValueOrDefault(normalized) ?? normalized;
    }

    private static string GetColumnSubtitle(BoardColumn column, int enabledCount)
    {
        if (enabledCount == 0 || column.IntervalSeconds == null || column.IntervalSeconds <= 0)
        {
            // Show the Schedule (the Title already is the Schedule for unnamed columns)
            if (column.Title != column.Schedule) return column.Schedule;
            return column.IntervalSeconds > 0 ? $"about every {FormatInterval(column.IntervalSeconds.Value)}" : null;
        }

        var runsPerHour = enabledCount * 3600.0 / column.IntervalSeconds.Value;
        return runsPerHour >= 1 ? $"{runsPerHour:N0} runs / hr" : $"{runsPerHour * 24:0.#} runs / day";
    }

    /// <summary>
    /// Runs take longer than the interval, so the Scheduled Task Worker skips occurrences
    /// </summary>
    private static bool IsOverlapping(BoardItem item)
    {
        if (item.Task == null || !item.Task.Enabled || item.AverageDuration <= 0) return false;

        var interval = item.Task.IntervalSeconds;
        return interval > 0 && item.AverageDuration >= interval * 1000;
    }

    private FunctionJob GetJob(string functionId, string jobId)
    {
        return functionId != null && jobs.TryGetValue(functionId, out var functionJobs) ? functionJobs.FirstOrDefault(o => o.Id == jobId) : null;
    }

    /// <summary>
    /// The Function ID with line breaks allowed after each '.', so long IDs wrap at their segments instead of being cut off
    /// </summary>
    private static MarkupString FormatFunctionId(string functionId)
    {
        var segments = (functionId ?? "").Split('.').Select(System.Net.WebUtility.HtmlEncode);
        return new MarkupString(string.Join(".<wbr>", segments));
    }

    private string GetFunctionLink(string functionId, string page = null)
    {
        var link = $"/_admin/explorer/{explorerService.SelectedInstanceId}/functions/{functionId}";
        return page != null ? $"{link}/{page}" : link;
    }

    private static string GetErrorMessage(TrakHoundApiResponse response)
    {
        var message = response.GetContentUtf8String();
        return !string.IsNullOrEmpty(message) ? message : $"Status Code {response.StatusCode}";
    }

    private static string GetResultClass(int statusCode)
    {
        if (statusCode >= 200 && statusCode < 400) return "success";
        if (statusCode == TrakHoundFunctionMetricsCollector.CancelledStatusCode) return "cancelled";
        return "error";
    }

    private static string FormatInterval(double seconds)
    {
        var interval = TimeSpan.FromSeconds(seconds);
        if (interval.TotalDays >= 1) return interval.TotalDays == 1 ? "day" : $"{interval.TotalDays:0.#} days";
        if (interval.TotalHours >= 1) return interval.TotalHours == 1 ? "hour" : $"{interval.TotalHours:0.#} hours";
        if (interval.TotalMinutes >= 1) return interval.TotalMinutes == 1 ? "minute" : $"{interval.TotalMinutes:0.#} min";
        return $"{seconds:0} sec";
    }

    private static string FormatDuration(double milliseconds)
    {
        var duration = TimeSpan.FromMilliseconds(milliseconds);
        if (duration.TotalHours >= 1) return $"{(int)duration.TotalHours}h {duration.Minutes:00}m";
        if (duration.TotalMinutes >= 1) return $"{duration.Minutes}m {duration.Seconds:00}s";
        if (duration.TotalSeconds >= 1) return $"{duration.TotalSeconds:0.#} s";
        return $"{milliseconds:0} ms";
    }

    private static string FormatTimestamp(DateTime? timestamp)
    {
        if (timestamp == null) return null;

        var local = timestamp.Value.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("HH:mm:ss") : local.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FormatRelative(DateTime? timestamp)
    {
        if (timestamp == null) return "-";

        var remaining = timestamp.Value.ToUniversalTime() - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "now";
        if (remaining.TotalDays >= 1) return $"in {(int)remaining.TotalDays}d {remaining.Hours}h";
        if (remaining.TotalHours >= 1) return $"in {(int)remaining.TotalHours}h {remaining.Minutes}m";
        if (remaining.TotalMinutes >= 1) return $"in {(int)remaining.TotalMinutes}m";
        return $"in {Math.Max(1, (int)remaining.TotalSeconds)}s";
    }

    #endregion
