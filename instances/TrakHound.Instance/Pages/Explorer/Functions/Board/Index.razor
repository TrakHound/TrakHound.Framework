    #region "Changes"

    private async void CreateSaveClicked()
    {
        if (createColumn == null) return;

        await CreateTask(createFunctionId, createColumn, createDescription, createJob);

        createModalVisible = !lastChangeSucceeded;
        await InvokeAsync(StateHasChanged);
    }

    private async void ConfirmMoveClicked()
    {
        var move = pendingMove;
        confirmModalVisible = false;
        pendingMove = null;

        if (move != null) await MoveTask(move.Item, move.Column);
    }

    private async void ToggleEnabledClicked(BoardItem item)
    {
        var task = item.Task;
        if (task == null) return;

        var enabled = !task.Enabled;

        await RunChange(enabled ? "Error Resuming Scheduled Task" : "Error Pausing Scheduled Task", async client =>
        {
            var error = await SetTask(client, item.FunctionId, task.Id, null, enabled);
            if (error != null) return error;

            undoAction = new UndoAction
            {
                Message = $"{(enabled ? "Resumed" : "Paused")} {item.FunctionId}",
                FunctionId = item.FunctionId,
                TaskId = task.Id,
                PreviousSchedule = task.Schedule,
                PreviousEnabled = task.Enabled
            };
            return null;
        });
    }

    private void DeleteClicked(BoardItem item)
    {
        deleteItem = item;
        deleteModalVisible = true;
    }

    private async void ConfirmDeleteClicked()
    {
        var item = deleteItem;
        deleteModalVisible = false;
        deleteItem = null;

        if (item?.Task != null)
        {
            await RunChange("Error Deleting Scheduled Task", async client =>
            {
                var response = await client.Api.Delete(Url.Combine("functions", item.FunctionId, "tasks", item.Task.Id));
                if (!response.Success) return GetErrorMessage(response);

                undoAction = null; // Deleted Tasks can't be restored (their Parameters aren't kept)
                notificationService.AddNotification(NotificationType.Success, $"Deleted Scheduled Task for {item.FunctionId}");
                return null;
            });
        }
    }

    private void ModalCancelClicked()
    {
        createModalVisible = false;
        columnModalVisible = false;
        confirmModalVisible = false;
        deleteModalVisible = false;
        pendingMove = null;
        deleteItem = null;
    }

    private async Task CreateTask(string functionId, BoardColumn column, string description, FunctionJob job)
    {
        await RunChange("Error Scheduling Function", async client =>
        {
            var queryParameters = new Dictionary<string, string>();
            queryParameters.Add("schedule", column.Schedule);
            queryParameters.Add("enabled", "true");
            if (!string.IsNullOrEmpty(description)) queryParameters.Add("description", description);
            if (job != null) queryParameters.Add("jobId", job.Id);

            var response = await client.Api.Post(Url.Combine("functions", functionId, "tasks"), queryParameters);
            if (!response.Success) return GetErrorMessage(response);

            var task = response.GetJsonContentObject<FunctionTaskSummary>();
            var name = job != null ? $"{functionId} ({job.Name})" : functionId;
            undoAction = task?.Id != null ? new UndoAction { Message = $"Scheduled {name} on {column.Title}", FunctionId = functionId, TaskId = task.Id, Created = true } : null;
            return null;
        });
    }

    /// <summary>
    /// Moves a Task to a column (its Enabled state is kept)
    /// </summary>
    private async Task MoveTask(BoardItem item, BoardColumn column)
    {
        var task = item.Task;

        await RunChange("Error Changing Schedule", async client =>
        {
            var error = await SetTask(client, item.FunctionId, task.Id, column.Schedule, null);
            if (error != null) return error;

            undoAction = new UndoAction
            {
                Message = $"Moved {item.FunctionId} to {column.Title}",
                FunctionId = item.FunctionId,
                TaskId = task.Id,
                PreviousSchedule = task.Schedule,
                PreviousEnabled = task.Enabled
            };
            return null;
        });
    }

    private async Task<string> SetTask(ITrakHoundClient client, string functionId, string taskId, string schedule, bool? enabled)
    {
        var taskRoute = Url.Combine("functions", functionId, "tasks", taskId);

        // Disable first (so the old schedule doesn't run again), and enable last (so the new schedule is in place)
        if (enabled == false)
        {
            var response = await client.Api.Put(Url.Combine(taskRoute, "disable"));
            if (!response.Success) return GetErrorMessage(response);
        }

        if (!string.IsNullOrEmpty(schedule))
        {
            var response = await client.Api.Put(taskRoute, new Dictionary<string, string> { { "schedule", schedule } });
            if (!response.Success) return GetErrorMessage(response);
        }

        if (enabled == true)
        {
            var response = await client.Api.Put(Url.Combine(taskRoute, "enable"));
            if (!response.Success) return GetErrorMessage(response);
        }

        return null;
    }

    private async void UndoClicked()
    {
        var action = undoAction;
        if (action == null) return;

        await RunChange("Error Undoing Change", async client =>
        {
            if (action.RemovedColumn != null)
            {
                var queryParameters = new Dictionary<string, string> { { "schedule", action.RemovedColumn.Schedule } };
                if (action.RemovedColumn.Title != action.RemovedColumn.Schedule) queryParameters.Add("title", action.RemovedColumn.Title);

                var response = await client.Api.Post("functions/schedule-columns", queryParameters);
                if (!response.Success) return GetErrorMessage(response);
            }
            else if (action.Created)
            {
                var response = await client.Api.Delete(Url.Combine("functions", action.FunctionId, "tasks", action.TaskId));
                if (!response.Success) return GetErrorMessage(response);
            }
            else
            {
                var error = await SetTask(client, action.FunctionId, action.TaskId, action.PreviousSchedule, action.PreviousEnabled);
                if (error != null) return error;
            }

            undoAction = null;
            return null;
        });
    }

    /// <summary>
    /// Runs a change (returns an error message, or null on success) and reloads the board
    /// </summary>
    private async Task RunChange(string errorTitle, Func<ITrakHoundClient, Task<string>> change)
    {
        if (busy) return;

        busy = true;
        lastChangeSucceeded = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var client = GetClient();
            if (client != null)
            {
                var error = await change(client);
                if (error == null)
                {
                    lastChangeSucceeded = true;
                }
                else
                {
                    notificationService.AddNotification(NotificationType.Error, errorTitle, error);
                }
            }
        }
        catch (Exception ex)
        {
            notificationService.AddNotification(NotificationType.Error, errorTitle, ex.Message);
        }
        finally
        {
            busy = false;
            await Reload(); // Also puts a card back if the change failed
        }
    }

