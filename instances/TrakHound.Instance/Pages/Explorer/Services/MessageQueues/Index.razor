    private string GetServiceName()
    {
        return !string.IsNullOrEmpty(service?.Name) ? service.Name : ConfigurationId;
    }

    private string GetDescription()
    {
        var description = !string.IsNullOrEmpty(service?.Description) ? service.Description : "MessageQueue Service";
        if (!string.IsNullOrEmpty(service?.PackageId)) description += $" · {service.PackageId}";
        return description;
    }

    private static string GetStatusText(QueueMessageStatus status)
    {
        switch (status)
        {
            case QueueMessageStatus.Pending: return "Pending";
            case QueueMessageStatus.AutoAcknowledged: return "Auto Acknowledged";
            case QueueMessageStatus.Acknowledged: return "Acknowledged";
            case QueueMessageStatus.Rejected: return "Rejected";
            case QueueMessageStatus.Returned: return "Returned";
            default: return "Failed";
        }
    }

    private static string GetStatusTitle(QueueMessage item)
    {
        if (!string.IsNullOrEmpty(item.StatusMessage)) return item.StatusMessage;

        switch (item.Status)
        {
            case QueueMessageStatus.Pending: return "Still on the Queue until it is Acknowledged or Rejected";
            case QueueMessageStatus.AutoAcknowledged: return "Removed from the Queue when it was delivered";
            case QueueMessageStatus.Acknowledged: return "Removed from the Queue";
            case QueueMessageStatus.Rejected: return "Returned to the Queue";
            case QueueMessageStatus.Returned: return "Not Acknowledged before its Channel closed, so it was returned to the Queue";
            default: return null;
        }
    }

    private static string GetStatusClass(QueueMessageStatus status)
    {
        switch (status)
        {
            case QueueMessageStatus.Pending: return "pending";
            case QueueMessageStatus.Failed: return "failed";
            case QueueMessageStatus.Rejected:
            case QueueMessageStatus.Returned: return "returned";
            default: return "done";
        }
    }

    private static string GetDetailsTitle(QueueMessage item)
    {
        var lines = new List<string>();
        lines.Add($"Received : {item.Received:o}");
        if (item.Published.HasValue) lines.Add($"Published : {item.Published.Value:o}");
        if (!string.IsNullOrEmpty(item.MessageId)) lines.Add($"Message ID : {item.MessageId}");
        if (!string.IsNullOrEmpty(item.ContentType)) lines.Add($"Content Type : {item.ContentType}");
        if (item.Headers != null)
        {
            foreach (var header in item.Headers) lines.Add($"{header.Key} : {header.Value}");
        }
        return string.Join("\n", lines);
    }

    private static string FormatTimestamp(DateTime timestamp)
    {
        return timestamp.Date == DateTime.Now.Date ? timestamp.ToString("HH:mm:ss.fff") : timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff");
    }

    internal static string GetErrorMessage(int statusCode, string message)
    {
        if (!string.IsNullOrEmpty(message)) return message;
        return statusCode > 0 ? $"Status Code {statusCode}" : "Service Not Available";
    }

