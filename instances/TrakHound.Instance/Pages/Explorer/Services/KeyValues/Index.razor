@page "/_admin/explorer/{instanceId}/services/key-values/{configurationId}"
@implements IDisposable
@inject ExplorerService explorerService
@using TrakHound.Blazor.Services
@using TrakHound.Services

<TrakHoundPageTitle Text="@($"{GetServiceName()} - KeyValues")" />

<TrakHound.Instance.Components.Notifications Items="@notificationService.Notifications" OnDismiss="notificationService.Dismiss" />

<div class="key-values-page">

    <div class="header-panel">
        <div class="header-content">
            <div class="header-icon">
                <span class="icon fa-solid fa-sharp fa-key"></span>
            </div>
            <div class="header-text">
                <span class="header-name">@GetServiceName()</span>
                <span class="header-description">@GetDescription()</span>
            </div>
        </div>
    </div>

    <div class="toolbar-panel">

        @if (!loading)
        {
            <button class="btn btn-light" @onclick="RefreshClicked"><span class="icon fa-solid fa-sharp fa-rotate"></span>Refresh</button>
        }
        else
        {
            <button class="btn btn-light btn-loading" disabled><span class="icon loading-icon fa-regular fa-loader spin"></span>Loading..</button>
        }

        <button class="admin-write btn @(showPublish ? "btn-secondary" : "btn-light")" @onclick="TogglePublish"><span class="icon fa-solid fa-sharp fa-plus"></span>Publish</button>

        <div class="filter">
            <span class="filter-icon fa-solid fa-sharp fa-magnifying-glass"></span>
            <input type="text" placeholder="Filter Collections" aria-label="Filter Collections" value="@filter" @oninput="FilterChanged" @onkeydown="FilterKeyDown" />
            @if (!string.IsNullOrWhiteSpace(filter))
            {
                <button class="btn-clear-filter" title="Clear Filter" @onclick="ClearFilter"><span class="fa-solid fa-sharp fa-xmark"></span></button>
            }
        </div>

    </div>

    <div class="publish-container">
        @if (showPublish)
        {
            <PublishPanel InstanceId="@InstanceId" ConfigurationId="@ConfigurationId" Published="ValuePublished" PublishFailed="ValuePublishFailed" Cancelled="() => showPublish = false" />
        }
    </div>

    @if (!loading)
    {
        <div class="content-panel">

            @if (errorMessage != null)
            {
                <div class="empty-panel error">
                    <span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>
                    <span class="empty-title">Collections could not be Loaded</span>
                    <span class="empty-description">@errorMessage</span>
                </div>
            }
            else if (collections.Count > 0)
            {
                var items = GetItems();
                if (!items.IsNullOrEmpty())
                {
                    <div class="table-panel">
                        <RadzenDataGrid Data="@items" TItem="CollectionItem" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="CollectionItem" CssClass="buttons view-cell" Width="75px" Sortable="false">
                                    <Template Context="item">
                                        <a href="@GetCollectionLink(item)" class="btn btn-sm btn-link"><span class="icon fa-regular fa-sharp fa-folder-open"></span>View</a>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="CollectionItem" Property="Name" Title="Collection" MinWidth="200px">
                                    <Template Context="item">
                                        <a href="@GetCollectionLink(item)" class="item-link">@item.Name</a>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="CollectionItem" Property="Count" Title="Keys" Width="120px" TextAlign="TextAlign.Right">
                                    <Template Context="item">
                                        @if (item.Count != null)
                                        {
                                            <span class="number">@item.Count.Value.ToString("N0")</span>
                                        }
                                        else if (countsLoading)
                                        {
                                            <span class="value-null"><span class="fa-regular fa-sharp fa-loader spin"></span></span>
                                        }
                                        else
                                        {
                                            <span class="value-null">-</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
                else
                {
                    <div class="empty-panel">
                        <span class="empty-title">No matching Collections</span>
                        <span class="empty-description">No Collections match "@filter?.Trim()"</span>
                    </div>
                }
            }
            else
            {
                <div class="empty-panel">
                    <span class="icon fa-solid fa-sharp fa-key"></span>
                    <span class="empty-title">No Collections</span>
                    <span class="empty-description">Publish a Value to create a Collection</span>
                    @if (!showPublish)
                    {
                        <button class="admin-write btn btn-light btn-empty-action" @onclick="() => showPublish = true"><span class="icon fa-solid fa-sharp fa-plus"></span>Publish</button>
                    }
                </div>
            }

        </div>
    }
    else
    {
        <div class="loading-panel">
            <Loading Message="Loading Collections.." />
        </div>
    }

</div>

@code {

    private readonly TrakHound.Instance.Components.NotificationService notificationService = new TrakHound.Instance.Components.NotificationService();

    private List<CollectionItem> collections = new List<CollectionItem>();
    private TrakHoundServiceInformation service;
    private string previousKey;
    private string filter;
    private string errorMessage;
    private bool showPublish;
    private bool loading = true;
    private bool countsLoading;
    private int loadVersion;


    [Parameter]
    public string InstanceId { get; set; }

    [Parameter]
    public string ConfigurationId { get; set; }


    public class CollectionItem
    {
        public string Name { get; set; }
        public int? Count { get; set; }
    }


    protected override void OnInitialized()
    {
        notificationService.Updated += NotificationsUpdated;
    }

    void IDisposable.Dispose()
    {
        loadVersion++;
        notificationService.Updated -= NotificationsUpdated;
        notificationService.Dispose();
    }

    protected async override Task OnParametersSetAsync()
    {
        // Only reload when navigating to a different Service
        var key = $"{InstanceId}:{ConfigurationId}";
        if (key != previousKey)
        {
            previousKey = key;
            filter = null;
            showPublish = false;

            await explorerService.LoadInstance(InstanceId);
            service = explorerService.GetServices(InstanceId, ConfigurationId);

            SetBreadcrumbs();

            await Load();
        }
    }

    private void SetBreadcrumbs()
    {
        var breadcrumbItems = new List<BreadcrumbItem>();
        breadcrumbItems.Add(new BreadcrumbItem(InstanceId, null));
        breadcrumbItems.Add(new BreadcrumbItem("Services", Url.Combine("_admin/explorer", InstanceId, "services")));
        breadcrumbItems.Add(new BreadcrumbItem("KeyValues", Url.Combine("_admin/explorer", InstanceId, "services", "key-values")));
        breadcrumbItems.Add(new BreadcrumbItem(GetServiceName(), null));
        explorerService.BreadcrumbItems = breadcrumbItems;
    }

    private async Task Load()
    {
        var version = ++loadVersion;

        loading = true;
        await InvokeAsync(StateHasChanged);

        errorMessage = null;

        var client = explorerService.GetClient(InstanceId, ConfigurationId);
        if (client != null)
        {
            try
            {
                var response = await client.Services.KeyValues.ListCollections(routerId: ConfigurationId);
                if (response.Success)
                {
                    // Replace the full list (so Collections that were removed don't remain)
                    collections = response.Result?
                        .Where(o => !string.IsNullOrEmpty(o))
                        .Distinct()
                        .Select(o => new CollectionItem { Name = o })
                        .ToList() ?? new List<CollectionItem>();
                }
                else if (response.StatusCode == 404)
                {
                    // Not Found is returned when there are no Collections
                    collections = new List<CollectionItem>();
                }
                else
                {
                    collections = new List<CollectionItem>();
                    errorMessage = !string.IsNullOrEmpty(response.Message) ? response.Message : $"Status Code {response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                collections = new List<CollectionItem>();
                errorMessage = ex.Message;
            }
        }
        else
        {
            collections = new List<CollectionItem>();
            errorMessage = $"Instance {InstanceId} is not available";
        }

        loading = false;
        await InvokeAsync(StateHasChanged);

        // Load the Counts after the list is shown (one request per Collection)
        if (client != null && collections.Count > 0)
        {
            await LoadCounts(client, collections, version);
        }
    }

    private async Task LoadCounts(TrakHound.Clients.ITrakHoundClient client, List<CollectionItem> items, int version)
    {
        countsLoading = true;
        await InvokeAsync(StateHasChanged);

        using (var throttle = new SemaphoreSlim(8))
        {
            var tasks = items.Select(async item =>
            {
                await throttle.WaitAsync();
                try
                {
                    if (version != loadVersion) return;

                    var response = await client.Services.KeyValues.Count(item.Name, routerId: ConfigurationId);
                    if (response.Success) item.Count = Math.Max(response.Result, 0);
                }
                catch { }
                finally
                {
                    throttle.Release();
                }
            });

            await Task.WhenAll(tasks);
        }

        if (version == loadVersion)
        {
            countsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<CollectionItem> GetItems()
    {
        var items = collections.OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(filter)) return items.ToList();

        var value = filter.Trim();
        return items.Where(o => o.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void FilterChanged(ChangeEventArgs args)
    {
        filter = args.Value?.ToString();
    }

    private void FilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") ClearFilter();
    }

    private void ClearFilter()
    {
        filter = null;
    }

    private async Task RefreshClicked()
    {
        await Load();
    }

    private void TogglePublish()
    {
        showPublish = !showPublish;
    }

    private async Task ValuePublished(PublishPanel.PublishResult result)
    {
        notificationService.AddNotification(NotificationType.Success, "Value Published", $"{result.Collection} / {result.Key}");
        await Load();
    }

    private void ValuePublishFailed(PublishPanel.PublishResult result)
    {
        notificationService.AddNotification(NotificationType.Error, "Publish Failed", $"{result.Collection} / {result.Key} : {result.Message}");
    }

    private async void NotificationsUpdated(object sender, EventArgs args)
    {
        await InvokeAsync(StateHasChanged);
    }


    private string GetServiceName()
    {
        return !string.IsNullOrEmpty(service?.Name) ? service.Name : ConfigurationId;
    }

    private string GetDescription()
    {
        var description = !string.IsNullOrEmpty(service?.Description) ? service.Description : "KeyValue Service";
        if (!string.IsNullOrEmpty(service?.PackageId)) description += $" · {service.PackageId}";
        if (!loading && errorMessage == null) description += collections.Count == 1 ? " · 1 Collection" : $" · {collections.Count:N0} Collections";
        return description;
    }

    private string GetCollectionLink(CollectionItem collection)
    {
        return Url.Combine("_admin/explorer", InstanceId, "services", "key-values", ConfigurationId, "collection", Uri.EscapeDataString(collection.Name));
    }

}
