@* Displays a history of a Worker's CPU Usage (percent of total machine capacity, 0 - 100) *@
@implements IDisposable
@inject TrakHound.Blazor.Services.TrakHoundThemeService themeService
@using TrakHound.Blazor.Services
@using TrakHound.Instance.Pages.Explorer.Diagnostics
@using TrakHound.Workers

<MetricsChart TItem="TrakHoundWorkerCpuSample" GetValue="@GetSampleValue" GetTimestamp="@GetSampleTimestamp"
              Title="@Title"
              Subtitle="@($"% of total machine capacity · last {GetWindowText()}")"
              Samples="@Samples"
              Series="@series"
              ValueFormatter="@FormatPercent"
              Max="100"
              Area="true"
              Borderless="@Borderless" />

@code {

    [Parameter]
    public IEnumerable<TrakHoundWorkerCpuSample> Samples { get; set; }

    [Parameter]
    public TimeSpan Window { get; set; } = TimeSpan.FromMinutes(5);

    [Parameter]
    public string Title { get; set; }

    /// <summary>
    /// Leave out the panel's border and padding (for a chart inside another panel or a table row)
    /// </summary>
    [Parameter]
    public bool Borderless { get; set; }


    private MetricsChartSeries[] series;


    protected override void OnInitialized()
    {
        UpdateSeries();
        themeService.ThemeChanged += ThemeChanged;
    }

    void IDisposable.Dispose()
    {
        themeService.ThemeChanged -= ThemeChanged;
    }

    private void ThemeChanged(object sender, TrakHoundThemes theme)
    {
        UpdateSeries();
        _ = InvokeAsync(StateHasChanged);
    }

    // A new Series when the Theme changes, so the chart is drawn again in its colors
    private void UpdateSeries()
    {
        var colors = MetricsChartColors.Get(themeService.Theme == TrakHoundThemes.Dark);
        series = new[] { new MetricsChartSeries("CPU", nameof(TrakHoundWorkerCpuSample.Usage), colors[0]) };
    }

    private static double GetSampleValue(TrakHoundWorkerCpuSample sample, string property) => sample.Usage;

    private static DateTime GetSampleTimestamp(TrakHoundWorkerCpuSample sample) => sample.Timestamp;

    private string GetWindowText() => Window.TotalMinutes >= 1 ? $"{Window.TotalMinutes:0} min" : $"{Window.TotalSeconds:0} sec";

    private static string FormatPercent(double value) => value >= 10 ? $"{value:0}%" : $"{value:0.#}%";

}
