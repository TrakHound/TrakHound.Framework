@* Plots one or more values of a time-series Sample over time (one value axis, shared by all Series).
   The chart is drawn in the browser (wwwroot/js/metrics-chart.js), so a live chart moves all the time instead of only when a Sample is added. *@
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="metrics-chart">
    <div class="metrics-chart-header">
        <span class="metrics-chart-title">@Title</span>
        <span class="metrics-chart-subtitle">@Subtitle</span>
    </div>

    @if (HasData)
    {
        var legend = _series.Count > 1;

        <div class="metrics-chart-plot @(legend ? "with-legend" : null)" @ref="_plot" role="img" aria-label="@GetDescription()"></div>

        @if (legend)
        {
            <div class="metrics-chart-legend" aria-hidden="true">
                @foreach (var series in _series)
                {
                    <span class="legend-item" @key="series.Property"><span class="legend-swatch" style="background: @series.Color;"></span>@series.Title</span>
                }
            </div>
        }
    }
    else
    {
        <div class="metrics-chart-empty">Collecting metrics..</div>
    }
</div>

@code {

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string Subtitle { get; set; }

    [Parameter]
    public IEnumerable<TItem> Samples { get; set; }

    [Parameter]
    public IEnumerable<MetricsChartSeries> Series { get; set; }

    /// <summary>
    /// Gets the Timestamp of a Sample (required)
    /// </summary>
    [Parameter]
    public Func<TItem, DateTime> GetTimestamp { get; set; }

    /// <summary>
    /// Gets the value of a Series (by Property name) from a Sample (required)
    /// </summary>
    [Parameter]
    public Func<TItem, string, double> GetValue { get; set; }

    /// <summary>
    /// The Samples are read as they happen, so the chart scrolls with the clock. Set to false for Samples that
    /// cover a fixed time (ex. time buckets), so the chart shows all of them and doesn't move
    /// </summary>
    [Parameter]
    public bool Live { get; set; } = true;

    /// <summary>
    /// Fill the area under the line (use for a single Series)
    /// </summary>
    [Parameter]
    public bool Area { get; set; }

    /// <summary>
    /// The value axis maximum (null to scale to the data)
    /// </summary>
    [Parameter]
    public object Max { get; set; }

    [Parameter]
    public Func<double, string> ValueFormatter { get; set; }

    /// <summary>
    /// Format of the (local) Timestamps in the Tooltip
    /// </summary>
    [Parameter]
    public string TimestampFormat { get; set; } = "HH:mm:ss";


    private IReadOnlyList<TItem> _samples = Array.Empty<TItem>();
    private IReadOnlyList<MetricsChartSeries> _series = Array.Empty<MetricsChartSeries>();

    private bool HasData => _samples.Count > 1 && _series.Count > 0 && GetTimestamp != null && GetValue != null;

    // What the browser has been sent, so only the Samples that were added are sent after the first time
    private ElementReference _plot;
    private string _sentPlotId;
    private IEnumerable<MetricsChartSeries> _sentSeries;
    private TItem _sentSample;
    private DateTime _sentTimestamp;
    private double[] _sentValues;
    private string _sentAxis;
    private bool? _matchByReference;
    private bool _disposed;


    // When no Max is set, scale the axis to a rounded value above the data (1, 2, 2.5, 5 x 10^n)
    // so the axis always has labelled ticks
    private double _axisMax = 1;
    private double _axisStep = 1;

    protected override void OnParametersSet()
    {
        _samples = Samples as IReadOnlyList<TItem> ?? Samples?.ToArray() ?? Array.Empty<TItem>();
        _series = Series?.Where(o => o != null).ToArray() ?? Array.Empty<MetricsChartSeries>();

        if (Max != null)
        {
            _axisMax = Math.Max(Convert.ToDouble(Max), double.Epsilon);
            _axisStep = GetNiceScale(_axisMax).step;
        }
        else
        {
            var dataMax = 0.0;
            if (HasData)
            {
                foreach (var sample in _samples)
                {
                    foreach (var series in _series)
                    {
                        var value = GetValue(sample, series.Property);
                        if (double.IsFinite(value)) dataMax = Math.Max(dataMax, value);
                    }
                }
            }

            (_axisMax, _axisStep) = GetNiceScale(dataMax);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasData)
        {
            _sentPlotId = null; // The plot was removed, so it's sent everything when it's shown again
            return;
        }

        try
        {
            var update = GetUpdate();
            if (update != null && !_disposed) await JS.InvokeVoidAsync("thMetricsChart.update", _plot, update);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (OperationCanceledException) { }
    }

    /// <summary>
    /// What to send to the browser : the Samples added since it was sent last (or all of them, when they aren't the ones
    /// it has), with the value axis. Null when nothing changed.
    /// </summary>
    private object GetUpdate()
    {
        var samples = _samples;

        // The Samples are added to when the one that was sent last is still among them
        var reset = _sentPlotId != _plot.Id || !ReferenceEquals(_sentSeries, Series) || _sentValues == null;
        var start = 0;
        if (!reset)
        {
            var index = FindSent(samples);
            if (index >= 0) start = index + 1;
            else reset = true;
        }

        var ticks = new List<object>();
        for (var i = 0; i * _axisStep <= _axisMax * 1.0001 && i < 20; i++)
        {
            var value = i * _axisStep;
            ticks.Add(new { v = value, l = FormatValue(value) ?? "" });
        }

        // The Instance's Time Zone, which the time axis is labelled in (as the rest of the page is)
        var offset = (int)Math.Round(TimeZoneInfo.Local.GetUtcOffset(DateTime.UtcNow).TotalMinutes);
        var axis = $"{_axisMax:R}|{string.Join(",", ticks.Select(o => o.ToString()))}|{offset}|{Area}|{Live}";

        var added = samples.Count - start;
        if (!reset && added == 0 && axis == _sentAxis) return null;

        var times = new long[added];
        var timeLabels = new string[added];
        for (var i = 0; i < added; i++)
        {
            var timestamp = GetTimestamp(samples[start + i]);
            times[i] = GetMilliseconds(timestamp);
            timeLabels[i] = timestamp.ToLocalTime().ToString(TimestampFormat);
        }

        var series = new List<object>();
        foreach (var item in _series)
        {
            var values = new double[added];
            var labels = new string[added];
            for (var i = 0; i < added; i++)
            {
                var value = GetValue(samples[start + i], item.Property);
                if (!double.IsFinite(value)) value = 0;

                values[i] = value;
                labels[i] = FormatValue(value) ?? "";
            }

            series.Add(new { title = item.Title, color = item.Color, values, labels });
        }

        var last = samples[samples.Count - 1];
        _sentPlotId = _plot.Id;
        _sentSeries = Series;
        _sentSample = last;
        _sentTimestamp = GetTimestamp(last);
        _sentValues = GetValues(last);
        _sentAxis = axis;

        return new
        {
            reset,
            live = Live,
            times,
            timeLabels,
            series,
            area = Area,
            max = _axisMax,
            ticks,
            offset,
            span = GetMilliseconds(GetTimestamp(last)) - GetMilliseconds(GetTimestamp(samples[0]))
        };
    }

    /// <summary>
    /// The index of the Sample that was sent last, or -1 when it isn't among the Samples (they're other Samples, ex. of another item).
    /// Pages that keep their Samples pass the same objects each time, so they're found by reference. Samples that are read
    /// again each time (ex. from a remote Instance) are found by their Timestamp and values instead.
    /// </summary>
    private int FindSent(IReadOnlyList<TItem> samples)
    {
        if (_matchByReference != false)
        {
            for (var i = samples.Count - 1; i >= 0; i--)
            {
                if (ReferenceEquals(samples[i], _sentSample))
                {
                    _matchByReference = true;
                    return i;
                }
            }

            // Once the Samples are known to be kept, one that is missing means they were replaced
            if (_matchByReference == true) return -1;
        }

        for (var i = samples.Count - 1; i >= 0; i--)
        {
            var timestamp = GetTimestamp(samples[i]);
            if (timestamp < _sentTimestamp) break;
            if (timestamp == _sentTimestamp)
            {
                if (!GetValues(samples[i]).SequenceEqual(_sentValues)) return -1;

                _matchByReference = false;
                return i;
            }
        }

        return -1;
    }

    private double[] GetValues(TItem sample) => _series.Select(o => GetValue(sample, o.Property)).ToArray();

    private static long GetMilliseconds(DateTime timestamp)
    {
        var utc = timestamp.Kind == DateTimeKind.Local ? timestamp.ToUniversalTime() : timestamp;
        return (long)(utc - DateTime.UnixEpoch).TotalMilliseconds;
    }

    // The chart is drawn on a canvas, so what it shows now is described for a screen reader
    private string GetDescription()
    {
        var latest = _samples[_samples.Count - 1];
        var values = _series.Select(o => $"{o.Title} {FormatValue(GetValue(latest, o.Property))}");
        return $"{Title} : {string.Join(", ", values)}";
    }

    private static (double max, double step) GetNiceScale(double value)
    {
        if (value <= 0 || double.IsNaN(value) || double.IsInfinity(value)) return (1, 1); // No data : just 0 and 1

        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(value)));
        var fraction = value / magnitude;

        if (fraction <= 1) return (magnitude, magnitude * 0.25);
        if (fraction <= 2) return (2 * magnitude, magnitude * 0.5);
        if (fraction <= 2.5) return (2.5 * magnitude, magnitude * 0.5);
        if (fraction <= 5) return (5 * magnitude, magnitude);
        return (10 * magnitude, magnitude * 2.5);
    }

    private string FormatValue(double value) => ValueFormatter != null ? ValueFormatter(value) : value.ToString("0.##");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        try
        {
            if (_sentPlotId != null) await JS.InvokeVoidAsync("thMetricsChart.dispose", _plot);
        }
        catch (Exception)
        {
            // The browser has gone (the script also cleans up a chart that is removed from the page)
        }
    }

}
