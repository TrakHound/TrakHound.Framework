@page "/_admin/explorer/{instanceId}/diagnostics/connections/api/requests"
@implements IDisposable
@inject ExplorerService explorerService
@using TrakHound.Api
@using TrakHound.Clients
@using TrakHound.Instance.Pages.Explorer.Diagnostics

<TrakHoundPageTitle Text="API Requests - Diagnostics" />

<div class="api-requests-page @(_selected != null ? "has-details" : null)">

    <div class="header-panel">
        <div class="header-content">
            <div class="header-icon">
                <span class="icon fa-solid fa-sharp fa-arrow-right-arrow-left"></span>
            </div>
            <div class="header-text">
                <span class="header-name">API Requests</span>
                <span class="header-description">@GetDescription()</span>
            </div>
        </div>
    </div>

    <div class="toolbar-panel">

        <div class="toolbar-row">
            <div class="btn-group">
                @if (!loading)
                {
                    <button class="btn btn-light" @onclick="RefreshClicked"><span class="icon fa-solid fa-sharp fa-rotate"></span>Refresh</button>
                }
                else
                {
                    <button class="btn btn-light btn-run btn-loading" disabled><span class="icon loading-icon fa-regular fa-loader spin"></span>Loading..</button>
                }

                @if (_paused)
                {
                    <button class="btn btn-light btn-paused" @onclick="PauseClicked" title="Resume updating every second"><span class="icon fa-solid fa-sharp fa-play"></span>Resume</button>
                }
                else
                {
                    <button class="btn btn-light" @onclick="PauseClicked" title="Stop updating so the rows stay where they are"><span class="icon fa-solid fa-sharp fa-pause"></span>Pause</button>
                }
            </div>

            <a class="btn btn-light" href="@GetMetricsLink(_apiFilter)"><span class="icon fa-solid fa-sharp fa-chart-simple"></span>API Metrics</a>

            <span class="update-status">@GetUpdateStatus()</span>
        </div>

        <div class="toolbar-row filters">
            <div class="status-filter" role="group" aria-label="Status">
                @foreach (var filter in _statusFilters)
                {
                    <button class="btn btn-filter @(filter == _statusFilter ? "active" : null)" @onclick="() => StatusFilterClicked(filter)">@filter</button>
                }
            </div>

            <RadzenDropDown TValue="string" Data="@_apis" @bind-Value="_apiFilter" @bind-Value:after="FilterChanged" AllowClear="true" Placeholder="All APIs" class="api-filter dropdown-sm" />

            <RadzenDropDown TValue="string" Data="@_sourceTypes" @bind-Value="_sourceFilter" @bind-Value:after="FilterChanged" AllowClear="true" Placeholder="All Sources" class="source-filter dropdown-sm" />

            <div class="slow-filter" title="Only show Requests that took at least this long (Streams are hidden)">
                <span class="filter-label">Slower than</span>
                <RadzenNumeric TValue="int?" @bind-Value="_slowFilter" @bind-Value:after="FilterChanged" Min="0" Step="100" Placeholder="ms" class="slow-filter-input" />
                <span class="filter-label">ms</span>
            </div>

            <label class="streams-filter" title="Stream Endpoints keep a connection open (their Duration is the time to open the Stream)">
                <RadzenCheckBox TValue="bool" @bind-Value="_showStreams" @bind-Value:after="FilterChanged" />
                <span class="filter-label">Streams</span>
            </label>

            @if (IsFiltered)
            {
                <button class="btn btn-link btn-clear" @onclick="ClearFiltersClicked">Clear filters</button>
            }
        </div>

    </div>

    @if (!loading)
    {
        <div class="table-panel">

            @if (_capacity == 0 && _received)
            {
                <div class="empty-panel">
                    <span class="icon fa-solid fa-sharp fa-arrow-right-arrow-left"></span>
                    <span class="empty-title">Recent API Requests are not kept</span>
                    <span class="empty-description">Set the API Requests to Keep in Settings > Metrics > Recent Requests (applied when the Instance is restarted)</span>
                </div>
            }
            else if (!_received)
            {
                <div class="empty-panel">
                    <span class="icon fa-solid fa-sharp fa-arrow-right-arrow-left"></span>
                    <span class="empty-title">No API Requests</span>
                    <span class="empty-description">The Recent API Requests are not available for this Instance</span>
                </div>
            }
            else
            {
                <RadzenDataGrid @ref="_grid"
                                Data="@_visible"
                                TItem="TrakHoundApiRequestRecord"
                                Density="Density.Compact"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Simple"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                AllowSorting="true"
                                AllowColumnResize="true"
                                AllowPaging="true"
                                PageSize="@_pageSize"
                                Page="@GridPageChanged"
                                RowClick="@RowClicked"
                                RowRender="@RowRender"
                                EmptyText="No Requests match the filters">
                    <Columns>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="Requested" Title="Time" Width="95px" Filterable="false">
                            <Template Context="context">
                                <span class="number" title="@FormatTimestamp(context.Requested)">@context.Requested.ToLocalTime().ToString("HH:mm:ss")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="Source" Title="Source" Width="190px">
                            <Template Context="context">
                                <span class="ellipsis" title="@context.Source">@context.Source</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="ApiId" Title="API" Width="160px">
                            <Template Context="context">
                                <span class="ellipsis" title="@GetApiTitle(context)">@context.ApiId</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="Method" Title="Method" Width="85px" Filterable="false" />
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="Path" Title="Path" MinWidth="240px">
                            <Template Context="context">
                                <span class="ellipsis path" title="@($"{context.Path} (Route: {context.Route})")">@if (context.IsStream) {<span class="stream-tag">Stream</span>}@(context.Path ?? context.Route)@if (!context.Query.IsNullOrEmpty()) {<span class="query-count">?@context.Query.Count</span>}</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="StatusCode" Title="Status" Width="90px" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="context">
                                <span class="number @GetStatusClass(context.StatusCode)" title="@(context.StatusCode == 0 && !context.IsStream ? "No Response (an HTTP client receives 404)" : context.Error)">@(context.StatusCode > 0 ? context.StatusCode.ToString() : "-")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="Duration" Title="Duration" Width="100px" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="context">
                                @if (context.IsStream)
                                {
                                    <span class="number stream-duration" title="The time to open the Stream">@FormatDuration(context.Duration)</span>
                                }
                                else
                                {
                                    <span class="number">@FormatDuration(context.Duration)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Title="" Width="90px" Sortable="false" Filterable="false" CssClass="duration-bar-column">
                            <Template Context="context">
                                @if (!context.IsStream)
                                {
                                    <DurationBar Min="0" Max="@_maxDuration" Value="@context.Duration.TotalMilliseconds" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="RequestBytes" Title="Received" Width="90px" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="context">
                                <span class="number">@(context.RequestBytes > 0 ? context.RequestBytes.ToFileSize() : "-")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrakHoundApiRequestRecord" Property="ResponseBytes" Title="Sent" Width="90px" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="context">
                                <span class="number">@(context.ResponseBytes > 0 ? context.ResponseBytes.ToFileSize() : "-")</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }

        </div>

        @if (_selected != null)
        {
            var request = _selected;

            <div class="details-panel">
                <div class="details-header">
                    <span class="details-method">@(request.IsStream ? "Stream" : request.Method.ToString())</span>
                    <span class="details-url" title="@request.Path">@(request.Path ?? request.Route)</span>
                    <span class="details-status @GetStatusClass(request.StatusCode)">@(request.StatusCode > 0 ? request.StatusCode.ToString() : "-")</span>
                    <button class="btn btn-link btn-close-details" @onclick="CloseDetailsClicked" title="Close (and resume updating)"><span class="fa-solid fa-sharp fa-xmark"></span></button>
                </div>

                <div class="details-content">
                    <table class="details-table">
                        <tr><td class="label">API</td><td class="value">@request.ApiId</td></tr>
                        <tr><td class="label">Package</td><td class="value">@(request.PackageId ?? "-")@if (!string.IsNullOrEmpty(request.PackageVersion)) {<span class="muted suffix">@request.PackageVersion</span>}</td></tr>
                        <tr><td class="label">Route</td><td class="value">@(request.Route ?? "-")@if (request.IsStream) {<span class="stream-tag stream-tag-after">Stream</span>}</td></tr>
                        <tr><td class="label">Source</td><td class="value">@request.Source@if (!string.IsNullOrEmpty(request.SourceId) && request.SourceId != request.SourceName) {<span class="muted suffix">(@request.SourceId)</span>}</td></tr>
                        @if (!string.IsNullOrEmpty(request.ClientAgent))
                        {
                            <tr><td class="label">User Agent</td><td class="value">@request.ClientAgent</td></tr>
                        }
                        @if (request.StatusCode == 0 && !request.IsStream)
                        {
                            <tr><td class="label">Status</td><td class="value">No Response <span class="muted">(the Endpoint returned an empty Response; an HTTP client receives 404)</span></td></tr>
                        }
                        <tr><td class="label">Requested</td><td class="value number">@FormatTimestamp(request.Requested)</td></tr>
                        <tr><td class="label">@(request.IsStream ? "Opened" : "Completed")</td><td class="value number">@FormatTimestamp(request.Completed)</td></tr>
                        <tr><td class="label">Duration</td><td class="value number">@FormatDuration(request.Duration)@if (request.IsStream) {<span class="muted suffix">(the time to open the Stream)</span>}</td></tr>
                        <tr><td class="label">Received</td><td class="value number">@FormatExactBytes(request.RequestBytes)</td></tr>
                        <tr><td class="label">Sent</td><td class="value number">@FormatExactBytes(request.ResponseBytes)</td></tr>
                        <tr><td class="label">Request ID</td><td class="value request-id" title="Shown in the Endpoint's Log entries for this Request (when its Logger records Debug, or for errors)">@(request.RequestId ?? "-")</td></tr>
                    </table>

                    <div class="details-query">
                        @if (!string.IsNullOrEmpty(request.Error))
                        {
                            <span class="details-section-title">Error</span>
                            <pre class="details-error @GetStatusClass(request.StatusCode)">@request.Error</pre>
                        }

                        <span class="details-section-title">Query</span>
                        @if (!request.Query.IsNullOrEmpty())
                        {
                            <table class="details-table query-table">
                                @foreach (var parameter in request.Query)
                                {
                                    var masked = parameter.Value == _mask;
                                    <tr><td class="label">@parameter.Key</td><td class="value @(masked ? "masked" : null)" title="@(masked ? "Hidden (sensitive parameter)" : null)">@parameter.Value</td></tr>
                                }
                            </table>
                        }
                        else
                        {
                            <span class="muted">No Query parameters</span>
                        }

                        <div class="details-links">
                            <a class="btn btn-light" href="@GetMetricsLink(request.ApiId)"><span class="icon fa-solid fa-sharp fa-chart-simple"></span>API Metrics</a>
                            @if (!string.IsNullOrEmpty(request.ControllerId) && !string.IsNullOrEmpty(request.EndpointId))
                            {
                                <a class="btn btn-light" href="@GetEndpointLink(request)"><span class="icon fa-solid fa-sharp fa-play"></span>Endpoint</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="loading-panel">
            <Loading Message="@loadingMessage" />
        </div>
    }

</div>

@code {

    private const int _updateInterval = 1000;
    private const string _mask = "***"; // TrakHoundHttpQueryMask.Mask
    private const string _statusAll = "All";
    private const string _statusErrors = "Errors";
    private static readonly string[] _statusFilters = new[] { _statusAll, "2xx", "3xx", "4xx", "5xx", _statusErrors };

    private TrakHoundApiRequestRecord[] _requests = Array.Empty<TrakHoundApiRequestRecord>();
    private List<TrakHoundApiRequestRecord> _visible = new List<TrakHoundApiRequestRecord>();

    // The grid returns to the first page when its Data changes, so the page being viewed is restored after each update
    private const int _pageSize = 50;
    private RadzenDataGrid<TrakHoundApiRequestRecord> _grid;
    private int _pageIndex;
    private bool _restorePage;

    // APIs and Source Types seen so far (kept so the filters' options don't change as Requests leave the buffer)
    private readonly SortedSet<string> _apis = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);
    private readonly SortedSet<string> _sourceTypes = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);

    private int _capacity;
    private bool _received;
    private double _maxDuration;
    private DateTime? _lastUpdated;

    // Identifies the buffer's contents (Request count and the sum of their Ids) so an unchanged buffer isn't sorted or rendered again
    private int _previousCount = -1;
    private long _previousIdSum;

    private System.Threading.Timer _updateTimer;
    private int _updating;
    private volatile bool _disposed;

    // Updates stop while Paused or while a Request's details are open (so the rows don't move)
    private bool _paused;
    private TrakHoundApiRequestRecord _selected;

    private string _statusFilter = _statusAll;
    private string _apiFilter;
    private string _sourceFilter;
    private int? _slowFilter;
    private bool _showStreams = true;

    private string previousInstanceId;
    private bool loading;
    private string loadingMessage;


    [Parameter]
    public string InstanceId { get; set; }


    void IDisposable.Dispose()
    {
        _disposed = true;
        _updateTimer?.Dispose();
    }

    protected async override Task OnParametersSetAsync()
    {
        await Load();
    }

    private async Task Load(bool forceReload = false)
    {
        if (forceReload || explorerService.SelectedInstanceId != previousInstanceId)
        {
            loading = true;
            loadingMessage = "Loading API Requests..";
            await InvokeAsync(StateHasChanged);

            _updateTimer?.Dispose();
            _requests = Array.Empty<TrakHoundApiRequestRecord>();
            _visible = new List<TrakHoundApiRequestRecord>();
            _apis.Clear();
            _sourceTypes.Clear();
            _received = false;
            _previousCount = -1;
            _selected = null;

            previousInstanceId = explorerService.SelectedInstanceId;

            await explorerService.LoadInstance(explorerService.SelectedInstanceId, forceReload);

            // Set Explorer Breadcrumbs
            var breadcrumbItems = new List<BreadcrumbItem>();
            breadcrumbItems.Add(new BreadcrumbItem(explorerService.SelectedInstanceId, null));
            breadcrumbItems.Add(new BreadcrumbItem("Diagnostics", null));
            breadcrumbItems.Add(new BreadcrumbItem("Connections", null));
            breadcrumbItems.Add(new BreadcrumbItem("API", null));
            breadcrumbItems.Add(new BreadcrumbItem("Requests", null));
            explorerService.BreadcrumbItems = breadcrumbItems;

            // Read from the selected Instance (which may not be the one hosting this page)
            var client = explorerService.GetClient(explorerService.SelectedInstanceId);
            if (client != null)
            {
                try { await UpdateRequests(client); } catch { }

                _updateTimer = new System.Threading.Timer(UpdateTimerElapsed, client, _updateInterval, _updateInterval);
            }

            loading = false;
            loadingMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> UpdateRequests(ITrakHoundClient client)
    {
        var recent = await client.Api.GetRecentRequests();
        if (recent != null)
        {
            _received = true;
            _capacity = recent.Capacity;

            var count = recent.Requests?.Count() ?? 0;
            long idSum = 0;
            if (recent.Requests != null) foreach (var request in recent.Requests) idSum += request.Id;
            if (count == _previousCount && idSum == _previousIdSum) return false;
            _previousCount = count;
            _previousIdSum = idSum;

            _requests = recent.Requests?.OrderByDescending(o => o.Id).ToArray() ?? Array.Empty<TrakHoundApiRequestRecord>();
            _lastUpdated = DateTime.Now;

            foreach (var request in _requests)
            {
                if (!string.IsNullOrEmpty(request.ApiId)) _apis.Add(request.ApiId);
                _sourceTypes.Add(request.SourceType.ToString());
            }

            UpdateVisible();
            return true;
        }

        return false;
    }

    private async void UpdateTimerElapsed(object state)
    {
        // Skip while Paused, or if the previous update is still running
        if (_disposed || _paused || _selected != null || Interlocked.Exchange(ref _updating, 1) == 1) return;

        try
        {
            if (state is ITrakHoundClient client)
            {
                // On the Renderer's context so the rows don't change while they are rendered
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;

                    // Only render when the Requests changed (rendering the grid is the expensive part)
                    if (await UpdateRequests(client))
                    {
                        _restorePage = _pageIndex > 0;
                        StateHasChanged();
                    }
                });
            }
        }
        catch
        {
            // The page may have been Disposed while updating
        }
        finally
        {
            Interlocked.Exchange(ref _updating, 0);
        }
    }

    private void GridPageChanged(PagerEventArgs args)
    {
        _pageIndex = args.PageIndex;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restorePage && _grid != null)
        {
            _restorePage = false;

            var lastPage = Math.Max(0, (_visible.Count - 1) / _pageSize);
            var page = Math.Min(_pageIndex, lastPage);
            if (page > 0) await _grid.GoToPage(page);
        }
    }

    private void UpdateVisible()
    {
        IEnumerable<TrakHoundApiRequestRecord> requests = _requests;

        switch (_statusFilter)
        {
            case "2xx": requests = requests.Where(o => o.StatusCode >= 200 && o.StatusCode < 300); break;
            case "3xx": requests = requests.Where(o => o.StatusCode >= 300 && o.StatusCode < 400); break;
            case "4xx": requests = requests.Where(o => o.StatusCode >= 400 && o.StatusCode < 500); break;
            case "5xx": requests = requests.Where(o => o.StatusCode >= 500); break;
            case _statusErrors: requests = requests.Where(o => o.StatusCode >= 400); break;
        }

        if (!string.IsNullOrEmpty(_apiFilter)) requests = requests.Where(o => string.Equals(o.ApiId, _apiFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_sourceFilter)) requests = requests.Where(o => string.Equals(o.SourceType.ToString(), _sourceFilter, StringComparison.OrdinalIgnoreCase));
        if (_slowFilter > 0) requests = requests.Where(o => !o.IsStream && o.Duration.TotalMilliseconds >= _slowFilter.Value);
        if (!_showStreams) requests = requests.Where(o => !o.IsStream);

        _visible = requests.ToList();

        // The Duration bars are relative to the slowest Request shown
        var durations = _visible.Where(o => !o.IsStream).Select(o => o.Duration.TotalMilliseconds);
        _maxDuration = durations.Any() ? durations.Max() : 0;
    }

    private bool IsFiltered => _statusFilter != _statusAll || !string.IsNullOrEmpty(_apiFilter) || !string.IsNullOrEmpty(_sourceFilter) || _slowFilter > 0 || !_showStreams;

    private void FilterChanged() => UpdateVisible();

    private void StatusFilterClicked(string filter)
    {
        _statusFilter = filter;
        UpdateVisible();
    }

    private void ClearFiltersClicked()
    {
        _statusFilter = _statusAll;
        _apiFilter = null;
        _sourceFilter = null;
        _slowFilter = null;
        _showStreams = true;
        UpdateVisible();
    }

    private async void RefreshClicked()
    {
        await Load(true);
    }

    private void PauseClicked()
    {
        _paused = !_paused;
    }

    private void RowClicked(DataGridRowMouseEventArgs<TrakHoundApiRequestRecord> args)
    {
        _selected = _selected?.Id == args.Data?.Id ? null : args.Data;
    }

    private void RowRender(RowRenderEventArgs<TrakHoundApiRequestRecord> args)
    {
        var classes = "request-row";
        if (_selected != null && args.Data?.Id == _selected.Id) classes += " selected";
        if (args.Data?.IsStream == true) classes += " stream-row";
        args.Attributes.Add("class", classes);
    }

    private void CloseDetailsClicked()
    {
        _selected = null;
    }


    private string GetDescription()
    {
        if (!_received) return "The most recent Requests to the APIs on this Instance";
        if (_capacity == 0) return "Recent API Requests are not kept by this Instance";
        return $"The most recent {_capacity:N0} Requests to the APIs on this Instance";
    }

    private string GetUpdateStatus()
    {
        if (loading || !_received) return null;

        var shown = IsFiltered ? $"{_visible.Count:N0} of {_requests.Length:N0} Requests" : $"{_requests.Length:N0} Requests";
        var updated = _lastUpdated != null ? $"updated {_lastUpdated:HH:mm:ss}" : null;

        if (_paused) return $"{shown} · Paused · {updated}";
        if (_selected != null) return $"{shown} · Paused while a Request is open · {updated}";
        return $"{shown} · {updated} · updates every second";
    }

    private static string GetApiTitle(TrakHoundApiRequestRecord request)
    {
        if (string.IsNullOrEmpty(request.PackageId)) return request.ApiId;
        return $"{request.ApiId} ({request.PackageId} {request.PackageVersion})";
    }

    private string GetMetricsLink(string apiId)
    {
        var link = $"_admin/explorer/{explorerService.SelectedInstanceId}/diagnostics/api";
        if (!string.IsNullOrEmpty(apiId)) link += $"?apiId={Uri.EscapeDataString(apiId)}";
        return link;
    }

    private string GetEndpointLink(TrakHoundApiRequestRecord request)
    {
        return $"_admin/explorer/{explorerService.SelectedInstanceId}/api/{Uri.EscapeDataString(request.ApiId)}/{Uri.EscapeDataString(request.ControllerId)}/{Uri.EscapeDataString(request.EndpointId)}";
    }

    private static string GetStatusClass(int statusCode)
    {
        if (statusCode >= 500) return "status-server-error";
        if (statusCode >= 400) return "status-error";
        if (statusCode >= 300) return "status-redirect";
        if (statusCode >= 100) return "status-success";
        return null;
    }

    private static string FormatTimestamp(DateTime timestamp) => timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff");

    private static string FormatExactBytes(long bytes) => bytes > 0 ? $"{bytes.ToFileSize()} ({bytes:N0} bytes)" : "-";

    private static string FormatDuration(TimeSpan duration)
    {
        var milliseconds = duration.TotalMilliseconds;
        if (milliseconds >= 60000) return duration.ToFormattedString();
        if (milliseconds >= 1000) return $"{milliseconds / 1000:0.##} s";
        if (milliseconds >= 10) return $"{milliseconds:0} ms";
        return $"{milliseconds:0.#} ms";
    }

}
