@inject TrakHound.Instance.Logging.History.TrakHoundLogHistoryService logHistoryService

@* What Log History keeps (Levels, Days, Size), with a link to its Settings. Explains why History can't go further back or lower *@
<span class="log-history-status">
    <span class="icon fa-solid fa-sharp fa-clock-rotate-left"></span>
    @if (logHistoryService.Store != null && logHistoryService.RunningConfiguration != null)
    {
        var configuration = logHistoryService.RunningConfiguration;
        var result = logHistoryService.LastMaintenanceResult;

        <span>
            Log History keeps @(configuration.MinimumLogLevel == TrakHoundLogLevel.Trace ? "every level" : $"{configuration.MinimumLogLevel} and above")
            for @(configuration.RetentionDays > 0 ? $"{configuration.RetentionDays} {(configuration.RetentionDays == 1 ? "day" : "days")}" : "as long as there is space")@(result != null ? $" · {FormatSize(result.ActiveSize)} stored" : "")
        </span>
    }
    else
    {
        <span class="error">Log History isn't running</span>
    }
    <a href="_admin/configuration/settings?section=logs">Settings</a>
</span>

@code {

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1073741824) return $"{bytes / 1073741824.0:0.00} GB";
        if (bytes >= 1048576) return $"{bytes / 1048576.0:0.0} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.0} KB";
        return $"{bytes} B";
    }

}
