@* The Package Sources, each with what it last answered, and a Reload button (shared by the Packages and Configuration pages).
   The one selected is remembered in the browser and set in the URL (?source=), so a link can open a Source *@
@inject TrakHound.Apps.ITrakHoundAppLocalStorageService localStorage
@inject NavigationManager navigationManager
@using TrakHound.Instance.Configurations

<div class="source-panel">
    @if (Context != null && Context.Sources.Any())
    {
        <span class="source-label">Source</span>
        <div class="source-list" role="radiogroup" aria-label="Package Source">
            @foreach (var source in Context.Sources)
            {
                var selected = string.Equals(source.Id, Context.SelectedSource?.Id, StringComparison.OrdinalIgnoreCase);
                var state = selected ? new PackageSourceState { Status = Context.SourceStatus, PackageCount = Context.SourcePackageCount, Error = Context.SourceError } : Context.GetSourceState(source.Id);

                <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" class="source-option @(selected ? "selected" : "") @state.Status.ToString().ToLower()" title="@GetTitle(source, state)" @onclick="() => Select(source.Id)">
                    @if (state.Status == PackageSourceStatus.Checking)
                    {
                        <span class="icon fa-solid fa-sharp fa-loader spin"></span>
                    }
                    else
                    {
                        <span class="status-dot"></span>
                    }
                    <span class="source-name">@source.Name</span>
                    @switch (state.Status)
                    {
                        case PackageSourceStatus.Online:
                            <span class="source-count">@state.PackageCount.ToString("N0")</span>
                            break;
                        case PackageSourceStatus.Offline:
                            <span class="source-count">Unreachable</span>
                            break;
                    }
                </button>
            }
        </div>
        <button class="btn btn-light btn-icon" title="Reload Packages from the Sources" @onclick="Reload" disabled="@(Context.SourceStatus == PackageSourceStatus.Checking)"><span class="icon fa-solid fa-sharp fa-rotate-right"></span></button>
    }
    else
    {
        <a class="no-source" href="_admin/packages/sources"><span class="icon fa-solid fa-sharp fa-circle-exclamation"></span>No Package Source configured</a>
    }
</div>

@code {

    [Parameter]
    public PackagesContext Context { get; set; }


    private async Task Select(string sourceId)
    {
        if (string.IsNullOrEmpty(sourceId)) return;

        var select = Context.SelectSource(sourceId);

        try { await localStorage.SetItem(PackagesContext.SelectedSourceStorageKey, sourceId); } catch { }

        // Replaced, so Back doesn't step through each Source
        var uri = navigationManager.GetUriWithQueryParameter("source", sourceId);
        if (uri != navigationManager.Uri) navigationManager.NavigateTo(uri, replace: true);

        await select;
    }

    private async Task Reload()
    {
        var check = Context.CheckSources();
        await Context.RefreshSource();
        await check;
    }

    private static string GetTitle(RemoteConfiguration source, PackageSourceState state)
    {
        var title = $"{source.Name} : {source.BaseUrl} ({source.Organization})";
        switch (state.Status)
        {
            case PackageSourceStatus.Online: return $"{title}\n{state.PackageCount:N0} packages";
            case PackageSourceStatus.Offline: return $"{title}\n{state.Error}";
            case PackageSourceStatus.Checking: return $"{title}\nConnecting..";
            default: return title;
        }
    }

}
