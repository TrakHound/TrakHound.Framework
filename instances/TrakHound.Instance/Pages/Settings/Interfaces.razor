@using TrakHound.Instances
@using TrakHound.Instance.Http
@inject ITrakHoundInstance instance
@inject TrakHound.Instance.Apps.TrakHoundAppConnectionService connectionService

<SettingsSection Title="HTTP" Description="The address, port and base path the Instance is served on (Admin Interface, Apps and Apis)" Icon="fa-solid fa-sharp fa-globe">
    <SettingsField Label="Address" Description="The IP Address to listen on. Leave empty to listen on all addresses." RequiresRestart="true" ReferencePath="httpAddress" References="@Model.References">
        <RadzenTextBox Immediate="true" @bind-Value="@Model.HttpAddress" @bind-Value:after="EditContext.Changed" Placeholder="All addresses" />
    </SettingsField>
    <SettingsField Label="Port" Description="The TCP Port to listen on" RequiresRestart="true" ReferencePath="httpPort" References="@Model.References">
        <RadzenNumeric TValue="int" @bind-Value="@Model.HttpPort" @bind-Value:after="EditContext.Changed" Min="1" Max="65535" />
    </SettingsField>
    <SettingsField Label="Base Path" Description="The URL path the Instance is served under when behind a reverse proxy (ex. /trakhound). Leave empty when served at the root." RequiresRestart="true" ReferencePath="basePath" References="@Model.References">
        <RadzenTextBox Immediate="true" @bind-Value="@Model.BasePath" @bind-Value:after="EditContext.Changed" Placeholder="/" />
    </SettingsField>
    <SettingsField Label="Max Request Size (MB)" Description="The largest request body accepted (ex. an upload to an Api or a Blob). Larger requests get 413 Payload Too Large. 0 = no limit. Under IIS, the site's web.config limit (maxAllowedContentLength) also applies. Applied when saved." ReferencePath="maxRequestBodySizeMb" References="@Model.References">
        <RadzenNumeric TValue="int" @bind-Value="@Model.MaxRequestBodySizeMb" @bind-Value:after="EditContext.Changed" Min="0" Max="1048576" />
    </SettingsField>
</SettingsSection>

<SettingsSection Title="Reverse Proxy" Description="Behind a reverse proxy (ex. nginx), every request comes from the proxy's address. List the proxies so the Instance uses the client's address and scheme from the X-Forwarded-For and X-Forwarded-Proto headers they send. Client addresses are used in logs, Rate Limits and the check that Module Tokens come from this computer." Icon="fa-solid fa-sharp fa-shuffle">
    <SettingsField Label="Trusted Proxies" Description="One per line : an IP Address (ex. 127.0.0.1) or Network (ex. 10.0.0.0/8). Only list your own proxies, since any client at these addresses can set its own address. Leave empty to ignore the headers. Applied when saved.">
        <div class="trusted-proxies">
            <RadzenTextArea Value="@Model.TrustedProxies" ValueChanged="@(o => { Model.TrustedProxies = o; EditContext.Changed(); })" Rows="3" Placeholder="127.0.0.1" class="list-input" />
        </div>
        @foreach (var invalid in TrakHoundTrustedProxies.GetInvalid(Model.TrustedProxies?.Split('\n')))
        {
            <span class="field-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>'@invalid.Trim()' is not an IP Address or Network, so it is ignored</span>
        }
    </SettingsField>
</SettingsSection>

<SettingsSection Title="Admin Port" Description="Serve the Admin Interface and the System API on their own port. Apps then run in a different browser origin than the Admin Interface, and the Admin Port can be limited to a management address or blocked by a firewall. Apps, APIs and App Sign In are only served on the HTTP port. This doesn't replace Admin Authentication." Icon="fa-solid fa-sharp fa-door-closed">
    <SettingsField Label="Separate Admin Port" Description="When enabled, the Admin Interface and the System API are no longer served on the HTTP port. Not supported when hosted by IIS or Docker." RequiresRestart="true">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.AdminPortEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.AdminPortEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
    @if (Model.AdminPortEnabled)
    {
        <SettingsField Label="Admin Port" Description="The TCP Port for the Admin Interface and the System API. Must be different from the HTTP port." RequiresRestart="true" ReferencePath="adminHttpPort" References="@Model.References">
            <RadzenNumeric TValue="int" @bind-Value="@Model.AdminHttpPort" @bind-Value:after="EditContext.Changed" Min="1" Max="65535" />
            @if (Model.AdminHttpPort == Model.HttpPort)
            {
                <span class="field-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>The Admin Port is the same as the HTTP port, so it is not used</span>
            }
        </SettingsField>
        <SettingsField Label="Admin Address" Description="The IP Address the Admin Port listens on (ex. 127.0.0.1 to only allow this computer). Leave empty to use the HTTP Address." RequiresRestart="true" ReferencePath="adminHttpAddress" References="@Model.References">
            <RadzenTextBox Immediate="true" @bind-Value="@Model.AdminHttpAddress" @bind-Value:after="EditContext.Changed" Placeholder="@(string.IsNullOrEmpty(Model.HttpAddress) ? "All addresses" : Model.HttpAddress)" />
        </SettingsField>
    }
</SettingsSection>

<SettingsSection Title="Admin Access" Description="Limit the Admin Interface to the computers that manage the Instance. Other clients get 404 Not Found for the Admin Interface, the same as when it is disabled. Apps, APIs and the System API are not affected (the System API is protected by Identity Profiles). This doesn't replace Admin Authentication." Icon="fa-solid fa-sharp fa-shield-halved">
    <SettingsField Label="Allowed Addresses" Description="One per line : a client IP Address (ex. 10.0.0.25) or Network (ex. 192.168.1.0/24). This computer (127.0.0.1 and ::1) is always allowed. Behind a reverse proxy, add it to Trusted Proxies so the client's own address is checked. Leave empty to allow every address. Applied when saved.">
        <div class="trusted-proxies">
            <RadzenTextArea Value="@Model.AdminAllowedAddresses" ValueChanged="@(o => { Model.AdminAllowedAddresses = o; EditContext.Changed(); })" Rows="3" Placeholder="All addresses" class="list-input" />
        </div>
        @{
            var allowedEntries = Model.AdminAllowedAddresses?.Split('\n');
        }
        @foreach (var invalid in TrakHoundTrustedProxies.GetInvalid(allowedEntries))
        {
            <span class="field-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>'@invalid.Trim()' is not an IP Address or Network, so it is ignored</span>
        }
        @if (connectionService.RemoteAddress != null && !TrakHoundAdminAddresses.WouldAllow(connectionService.RemoteAddress, allowedEntries))
        {
            <span class="field-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>Your address (@connectionService.RemoteAddress) is not in the list, so this browser will lose access to the Admin Interface when saved</span>
        }
    </SettingsField>
</SettingsSection>

<SettingsSection Title="Apps and APIs" Description="Serve the configured Apps and APIs over HTTP. Disable them for an Instance that only runs Functions and Workers (APIs are still available to them within the Instance)." Icon="fa-solid fa-sharp fa-browsers">
    <SettingsField Label="Serve Apps over HTTP" Description="When disabled, App pages (including the root /) return 404 Not Found. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.AppsHttpEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.AppsHttpEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
    <SettingsField Label="Serve APIs over HTTP" Description="When disabled, API requests (and Streams) over HTTP return 404 Not Found. Functions, Workers, Apps and the Admin Interface can still use the APIs. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.ApiHttpEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.ApiHttpEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
    <SettingsField Label="Initialization Page" Description="While the Instance is starting, restarting or stopped, browsers requesting an App are sent to the Initialization Page (/_init), which reloads the App when the Instance is running. When disabled, these requests return 503 Service Unavailable instead. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.InitializationPageEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.InitializationPageEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
    <SettingsField Label="Custom Initialization Page" Description="A folder (relative to the Configuration Profile's folder, or absolute) with an index.html to show instead of the built-in Initialization Page, ex. a branded loading screen. Its other files (images, stylesheets) are served at /_init/assets/... and are public. Leave empty to use the built-in page. Applied when saved.">
        <RadzenTextBox Immediate="true" @bind-Value="@Model.InitializationPagePath" @bind-Value:after="EditContext.Changed" Placeholder="Built-in page" Disabled="@(!Model.InitializationPageEnabled)" />
        @if (Model.InitializationPageEnabled && !string.IsNullOrWhiteSpace(Model.InitializationPagePath))
        {
            var pageFile = TrakHoundInitializationPage.GetCustomPageFile(instance.ConfigurationPath, Model.InitializationPagePath);
            if (pageFile == null || !System.IO.File.Exists(pageFile))
            {
                <span class="field-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>'@(pageFile ?? Model.InitializationPagePath.Trim())' was not found, so the built-in page is shown</span>
            }
        }
        @if (Model.InitializationPageEnabled)
        {
            <a class="field-link" href="@(TrakHoundInitializationPage.Route)?preview" target="_blank">Preview the Initialization Page (saved settings)</a>
        }
    </SettingsField>
    <SettingsField Label="Error Page" Description="Show the Error Page (/_error) when an unhandled error occurs or an Admin page is not found. Routes that are not configured always get a plain 404. When disabled, a plain 'Not Found' message or an empty 500 Internal Server Error response is returned instead. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.ErrorPageEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.ErrorPageEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
</SettingsSection>

<SettingsSection Title="System API" Description="The Instance management API (/_api, /_apps, /_logs, /_services, ...) used by Clients and other Instances" Icon="fa-solid fa-sharp fa-plug">
    <SettingsField Label="Enable System API" Description="When disabled, System API requests return 404 Not Found. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.SystemApiEnabled" @bind-Value:after="EditContext.Changed" />
            <span class="switch-label">@(Model.SystemApiEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
    <SettingsField Label="Unprotected Remote Access" Description="Allow requests from other machines to System Resources and Service operations that no Identity Profile covers. When not allowed, an unprotected Resource can only be used from the same machine as the Instance, and other machines get 403 Forbidden until a Profile protects it. Only allow this on a trusted network. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.SystemApiUnprotectedRemoteAccess" @bind-Value:after="EditContext.Changed" Disabled="@(!Model.SystemApiEnabled)" />
            <span class="switch-label">@(Model.SystemApiUnprotectedRemoteAccess ? "Allowed" : "Not Allowed")</span>
        </div>
    </SettingsField>
    <SettingsField Label="MCP Server" Description="Serve an MCP (Model Context Protocol) Server at /_mcp so AI clients (ex. Claude) can run Functions, query Logs, Tables and Key Values, and more. Served on the HTTP port (and the Admin Port). Like the rest of the System API, access is restricted by Identity Profiles: without one covering the System Resources, it can only be used from the same machine (unless Unprotected Remote Access is allowed). Requires the System API. Applied when saved.">
        <div class="switch-control">
            <RadzenSwitch @bind-Value="@Model.McpEnabled" @bind-Value:after="EditContext.Changed" Disabled="@(!Model.SystemApiEnabled)" />
            <span class="switch-label">@(Model.McpEnabled && Model.SystemApiEnabled ? "Enabled" : "Disabled")</span>
        </div>
    </SettingsField>
</SettingsSection>

@code {

    [Parameter]
    public InstanceSettingsModel Model { get; set; }

    [CascadingParameter]
    public SettingsEditContext EditContext { get; set; }

}
