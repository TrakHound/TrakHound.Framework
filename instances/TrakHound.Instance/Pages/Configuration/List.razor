@page "/_admin/configuration/{CategoryKey}"
@page "/_admin/workspaces/{WorkspaceId}/configuration/{CategoryKey}"
@attribute [TrakHound.Instance.Security.AdminResourceDynamic]
@layout ConfigurationLayout
@implements IDisposable
@inject ConfigurationsService configurationsService
@using TrakHound.Configurations
@using TrakHound.Instance.Pages.Packages
@using TrakHound.Packages

@if (category == null)
{
    <div class="list-page">
        <div class="empty-state">
            <span class="empty-icon fa-regular fa-sharp fa-circle-question"></span>
            <span class="empty-title">Unknown Configuration Category '@CategoryKey'</span>
            <a class="btn btn-light" href="@configurationsService.GetLink("_admin/configuration")">Back to Overview</a>
        </div>
    </div>
}
else
{
    <TrakHoundPageTitle Text="@category.Title" />
    <AreaBreadcrumbs Items="@([new(category.Title)])" />

    <div class="list-page">

        <div class="list-header">
            <span class="list-icon @category.Icon"></span>
            <div class="list-title">
                <span class="title">@category.Title</span>
                <span class="description">@category.Description</span>
            </div>
        </div>

        <div class="toolbar">
            <div class="toolbar-search">
                <span class="search-icon fa-solid fa-sharp fa-magnifying-glass"></span>
                <input class="form-control" type="search" placeholder="@($"Search {category.Title.ToLower()}..")" value="@search" @oninput="e => search = e.Value?.ToString()" spellcheck="false" />
            </div>
            <div class="toolbar-buttons">
                <button class="btn btn-light" @onclick="Refresh" title="Reload the configurations and their status"><span class="icon fa-solid fa-sharp fa-rotate-right @(statusLoading ? "spin" : "")"></span>Refresh</button>
                <a class="admin-write btn btn-primary" href="@configurationsService.GetLink($"_admin/configuration/{category.Key}/new")"><span class="icon fa-solid fa-sharp fa-plus"></span>Add @category.SingularTitle</a>
            </div>
        </div>

        <div class="table-container">
            @if (configurations.IsNullOrEmpty())
            {
                <div class="empty-state">
                    <span class="empty-icon @category.Icon"></span>
                    <span class="empty-title">No @category.Title configured</span>
                    <span class="empty-description">@category.Description. Add a configuration to choose a Package and its settings.</span>
                    <a class="admin-write btn btn-primary" href="@configurationsService.GetLink($"_admin/configuration/{category.Key}/new")"><span class="icon fa-solid fa-sharp fa-plus"></span>Add @category.SingularTitle</a>
                </div>
            }
            else
            {
                var rows = GetFilteredRows();

                @if (rows.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon fa-regular fa-sharp fa-file-magnifying-glass"></span>
                        <span class="empty-title">No @category.Title match "@search"</span>
                        <button class="btn btn-light" @onclick="() => search = null">Clear Search</button>
                    </div>
                }
                else
                {
                    <table class="config-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                @if (category.HasRoute)
                                {
                                    <th class="col-route">Route</th>
                                }
                                @if (category.HasFunctionId)
                                {
                                    <th class="col-route">Function ID</th>
                                }
                                <th>Package</th>
                                <th class="col-status">Status</th>
                                @if (category.HasRouter)
                                {
                                    <th class="col-router">Router</th>
                                }
                                <th class="col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var configuration in rows)
                            {
                                var package = configurationsService.ResolvePackage(configuration);
                                var status = statusLoading && loadedIds == null ? ConfigurationStatus.Unknown : configurationsService.GetStatus(configuration, loadedIds);
                                var update = configurationsService.Packages.GetUpdate(configuration.PackageId);
                                // A Prerelease is offered when another Configuration of the Package includes Prereleases, but this one wouldn't use it
                                if (update != null && configuration.UseLatest && !configuration.IncludePrereleases && !TrakHound.Extensions.VersionComparer.IsStable(update.Version)) update = null;
                                var updating = updatingIds.Contains(configuration.PackageId ?? "");
                                var editLink = configurationsService.GetLink(ConfigurationCategories.GetLink(category.ConfigurationCategory, configuration.Id));

                                <tr>
                                    <td class="col-name">
                                        <a class="config-name" href="@editLink">@category.GetDisplayName(configuration)</a>
                                        @if (!string.IsNullOrEmpty(configuration.Description))
                                        {
                                            <span class="config-description">@configuration.Description</span>
                                        }
                                    </td>
                                    @if (category.HasRoute)
                                    {
                                        <td class="col-route"><code>@ConfigurationCategoryDefinition.NormalizeRoute(configuration.Route)</code></td>
                                    }
                                    @if (category.HasFunctionId)
                                    {
                                        <td class="col-route"><code>@configuration.FunctionId</code></td>
                                    }
                                    <td class="col-package">
                                        <span class="package-id" title="@configuration.PackageId">@configuration.PackageId</span>
                                        <span class="package-version">
                                            @if (configuration.UseLatest)
                                            {
                                                <span title="@(configuration.IncludePrereleases ? "The latest installed version, including prereleases" : "The latest installed stable version")">@(configuration.IncludePrereleases ? "Latest (prereleases)" : "Latest")</span>
                                                @if (package != null)
                                                {
                                                    <span class="muted"> · v@(package.Version)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>v@(configuration.PackageVersion)</span>
                                            }
                                        </span>
                                        @if (update != null)
                                        {
                                            @if (configuration.UseLatest)
                                            {
                                                @if (!updating)
                                                {
                                                    <button class="admin-write btn btn-sm btn-link btn-update" title="Install v@(update.Version) from @configurationsService.Packages.SelectedSource?.Name (used automatically)" @onclick="() => InstallUpdate(configuration.PackageId, update)"><span class="icon fa-solid fa-sharp fa-up-to-line"></span>Update to v@(update.Version)</button>
                                                }
                                                else
                                                {
                                                    <span class="updating"><span class="icon fa-solid fa-sharp fa-loader spin"></span>Updating..</span>
                                                }
                                            }
                                            else
                                            {
                                                <a class="btn btn-sm btn-link btn-update" href="@editLink" title="This configuration uses a specific version. Edit it to change the version."><span class="icon fa-solid fa-sharp fa-up-to-line"></span>v@(update.Version) available</a>
                                            }
                                        }
                                    </td>
                                    <td class="col-status">
                                        @switch (status)
                                        {
                                            case ConfigurationStatus.Running:
                                                <span class="status running"><span class="status-dot"></span>Running</span>
                                                break;
                                            case ConfigurationStatus.NotLoaded:
                                                <span class="status not-loaded" title="The configuration is not loaded. Check the log for errors."><span class="status-dot"></span>Not loaded</span>
                                                break;
                                            case ConfigurationStatus.PackageMissing:
                                                <span class="status missing" title="@(configuration.UseLatest ? $"{configuration.PackageId} is not installed" : $"{configuration.PackageId} v{configuration.PackageVersion} is not installed")"><span class="status-dot"></span>Package missing</span>
                                                break;
                                            default:
                                                <span class="status unknown">@(statusLoading ? "Checking.." : "Unknown")</span>
                                                break;
                                        }
                                        @if (status == ConfigurationStatus.NotLoaded || status == ConfigurationStatus.PackageMissing)
                                        {
                                            var logLink = configurationsService.GetLogLink(category, configuration);
                                            if (logLink != null)
                                            {
                                                <a class="log-link" href="@logLink" title="View the log for @configuration.PackageId"><span class="fa-solid fa-sharp fa-file-lines"></span></a>
                                            }
                                        }
                                    </td>
                                    @if (category.HasRouter)
                                    {
                                        <td class="col-router">
                                            @if (!string.IsNullOrWhiteSpace(configuration.RouterId))
                                            {
                                                @configuration.RouterId
                                            }
                                            else
                                            {
                                                var groupRouterId = category.HasGroup ? TrakHound.Groups.TrakHoundGroups.GetRouterId(configurationsService.ConfigurationProfile, null, configuration.GroupId) : null;
                                                <span class="muted" title="@(groupRouterId != null ? $"The Router of the Group {configuration.GroupId}" : "The default Router")">@(groupRouterId ?? "default")</span>
                                            }
                                        </td>
                                    }
                                    <td class="col-actions">
                                        <a class="btn btn-sm btn-command" href="@editLink"><span class="icon fa-regular fa-sharp fa-pen-to-square"></span>Edit</a>
                                        <button class="admin-write btn btn-sm btn-command btn-remove" @onclick="() => OpenRemove(configuration)"><span class="icon fa-regular fa-sharp fa-trash-can"></span>Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>

    </div>

    @* Remove Dialog *@
    <Modal Class="packages-modal" Visible="@(removeConfiguration != null)">
        <HeaderContent>
            <span class="modal-header-icon fa-regular fa-sharp fa-trash-can"></span>
            <span class="modal-header-title">Remove @category.SingularTitle</span>
        </HeaderContent>
        <BodyContent>
            @if (removeConfiguration != null)
            {
                <p class="modal-description">Remove this configuration? It stops running and is deleted from the Configuration Profile.</p>
                <div class="remove-summary">
                    <span class="label">Name</span><span>@category.GetDisplayName(removeConfiguration)</span>
                    @if (category.HasRoute)
                    {
                        <span class="label">Route</span><span><code>@ConfigurationCategoryDefinition.NormalizeRoute(removeConfiguration.Route)</code></span>
                    }
                    <span class="label">Package</span><span>@removeConfiguration.PackageId @removeConfiguration.VersionText</span>
                    <span class="label">ID</span><span class="muted">@removeConfiguration.Id</span>
                </div>

                @if (removePackage != null)
                {
                    <label class="remove-package">
                        <input type="checkbox" @bind="removePackageSelected" disabled="@removePackageUsed" />
                        <span>
                            Also remove the package <strong>@removePackage.Id v@(removePackage.Version)</strong>
                            @if (removePackageUsed)
                            {
                                <span class="muted">(used by other configurations)</span>
                            }
                            else
                            {
                                <span class="muted">(not used by any other configuration)</span>
                            }
                        </span>
                    </label>
                }
            }
        </BodyContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="CloseRemove" disabled="@removing"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
            @if (!removing)
            {
                <button class="admin-write btn btn-danger" @onclick="ConfirmRemove"><span class="icon fa-regular fa-sharp fa-trash-can"></span>Remove</button>
            }
            else
            {
                <button class="admin-write btn btn-danger disabled" disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span>Removing..</button>
            }
        </FooterContent>
    </Modal>
}

@code {

    // The Profile subscribed to (kept, since the URL has already changed when the page is disposed)
    private ITrakHoundConfigurationProfile _subscribedProfile;
    private ITrakHoundConfigurationProfile subscribedProfile => _subscribedProfile ??= configurationsService.ConfigurationProfile;

    // Set by the Workspace route ("_admin/workspaces/{WorkspaceId}/..."). ConfigurationsService reads the Workspace from the URL
    [Parameter]
    public string WorkspaceId { get; set; }

    private ConfigurationCategoryDefinition category;
    private List<ConfigurationModel> configurations;
    private HashSet<string> loadedIds;
    private bool statusLoading;
    private string search;
    private readonly HashSet<string> updatingIds = new HashSet<string>();
    private string lastCategoryKey;

    private ConfigurationModel removeConfiguration;
    private TrakHoundPackage removePackage;
    private bool removePackageUsed;
    private bool removePackageSelected;
    private bool removing;


    [Parameter]
    public string CategoryKey { get; set; }


    protected override void OnInitialized()
    {
        configurationsService.Packages.Changed += PackagesChanged;
        subscribedProfile.ConfigurationAdded += ConfigurationChanged;
        subscribedProfile.ConfigurationRemoved += ConfigurationChanged;

        // A Configuration that now includes Prereleases (or no longer does) changes which Version of its Package is an Update. The list
        // re-renders when the Source is reloaded (Packages.Changed)
        _ = RefreshSourceIfPrereleasesChanged();
    }

    private async Task RefreshSourceIfPrereleasesChanged()
    {
        try
        {
            await configurationsService.Packages.RefreshSourceIfPrereleasesChanged();
        }
        catch { } // The Updates shown stay as they were
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CategoryKey != lastCategoryKey)
        {
            lastCategoryKey = CategoryKey;
            category = ConfigurationCategories.Get(CategoryKey);
            search = null;
            loadedIds = null;
            LoadConfigurations();
            await LoadStatus();
        }
    }

    public void Dispose()
    {
        configurationsService.Packages.Changed -= PackagesChanged;
        if (_subscribedProfile != null)
        {
            _subscribedProfile.ConfigurationAdded -= ConfigurationChanged;
            _subscribedProfile.ConfigurationRemoved -= ConfigurationChanged;
        }
    }


    private void PackagesChanged() => _ = InvokeAsync(StateHasChanged);

    private void ConfigurationChanged(object sender, object args)
    {
        _ = InvokeAsync(() =>
        {
            LoadConfigurations();
            StateHasChanged();
        });
    }

    private void LoadConfigurations()
    {
        // Only the Modules in the Zones the signed in Admin's Role is limited to (all of them, without that limit)
        configurations = category?.Load(configurationsService.ConfigurationProfile)?
            .Where(o => configurationsService.CanView(category.ConfigurationCategory, o.Id))
            .OrderBy(o => category.GetDisplayName(o), StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task LoadStatus()
    {
        if (category == null) return;

        statusLoading = true;
        await InvokeAsync(StateHasChanged);

        loadedIds = await configurationsService.GetLoadedConfigurationIds(category);

        statusLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Refresh()
    {
        LoadConfigurations();
        await LoadStatus();
    }

    private List<ConfigurationModel> GetFilteredRows()
    {
        if (string.IsNullOrWhiteSpace(search)) return configurations;

        var query = search.Trim();
        return configurations.Where(o =>
            Contains(category.GetDisplayName(o), query) ||
            Contains(o.Description, query) ||
            Contains(o.Route, query) ||
            Contains(o.FunctionId, query) ||
            Contains(o.PackageId, query) ||
            Contains(o.Id, query)).ToList();
    }

    private static bool Contains(string value, string query) => value != null && value.Contains(query, StringComparison.OrdinalIgnoreCase);


    private async Task InstallUpdate(string packageId, TrakHoundPackage update)
    {
        updatingIds.Add(packageId);
        await InvokeAsync(StateHasChanged);

        try
        {
            await configurationsService.Packages.InstallFromSource(update);
        }
        finally
        {
            updatingIds.Remove(packageId);
            await LoadStatus();
        }
    }


    private void OpenRemove(ConfigurationModel configuration)
    {
        removeConfiguration = configuration;
        // Removing from a Workspace never uninstalls a Package from this Instance
        removePackage = configurationsService.Target.IsLive ? configurationsService.ResolvePackage(configuration) : null;
        removePackageUsed = removePackage != null && (configurationsService.IsPackageUsedByOthers(removePackage, configuration.Id) || configurationsService.Instance.IsProfilePackage(removePackage));
        removePackageSelected = false;
    }

    private void CloseRemove()
    {
        removeConfiguration = null;
        removePackage = null;
    }

    private async Task ConfirmRemove()
    {
        if (removeConfiguration == null) return;

        removing = true;
        await InvokeAsync(StateHasChanged);

        var configuration = removeConfiguration;
        var package = removePackageSelected && !removePackageUsed ? removePackage : null;
        var name = category.GetDisplayName(configuration);

        try
        {
            await Task.Run(() => configurationsService.Remove(category, configuration.Id));

            var message = category.HasRoute ? ConfigurationCategoryDefinition.NormalizeRoute(configuration.Route) : configuration.PackageId;
            if (package != null)
            {
                // Check again that no other Configuration uses the Package version
                if (!configurationsService.IsPackageUsedByOthers(package, configuration.Id) && configurationsService.Packages.CanUninstall && configurationsService.Packages.Uninstall(package.Id, package.Version))
                {
                    message += $" · Removed package {package.Id} v{package.Version}";
                }
                else
                {
                    configurationsService.Packages.Notify(PackageNotificationType.Warning, $"Package {package.Id} v{package.Version} was not Removed", "It is used by another configuration, or could not be uninstalled");
                }
            }

            configurationsService.Packages.Notify(PackageNotificationType.Success, $"Removed {name}", message);
        }
        catch (Exception ex)
        {
            configurationsService.Packages.Notify(PackageNotificationType.Error, $"Remove {name} Failed", ex.Message);
        }
        finally
        {
            removing = false;
            CloseRemove();
            LoadConfigurations();
            await LoadStatus();
        }
    }

}
