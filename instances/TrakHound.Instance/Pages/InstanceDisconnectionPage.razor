@using TrakHound.Instances
@inject TrakHoundInstanceConfiguration instanceConfiguration

@* Shown by trakhound-blazor.js while the Blazor circuit is disconnected (the elements are found by ID, the state is set as data-state on the panel).
   Not a <main>: the page has its own, and this one (hidden, and first in the document) would be taken for it *@

<div id="reconnection-panel" class="disconnection-page" style="display: none;" role="alertdialog" aria-modal="true" aria-labelledby="reconnection-panel-title" aria-describedby="reconnection-panel-description">
    <div class="disconnection-main">
        <div class="disconnection-container">
            <div class="disconnection-header">
                <div class="logo-container">
                    @* Inline (not img/trakhound-logo.svg) since the server may already be down when this is first shown *@
                    <svg class="logo-image" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1027 717" aria-hidden="true"><path fill="currentColor" transform="matrix(.1 0 0 -.1 0 717)" d="M470 6252 l0 -592 885 0 885 0 0 -2660 0 -2660 770 0 770 0 0 2660 0 2660 1825 0 1825 0 0 585 0 585 -1682 0 c-926 0 -2492 3 -3480 7 l-1798 6 0 -591z M8380 5475 l0 -1355 -1125 0 -1125 0 0 355 0 355 -700 0 -700 0 0 -2245 0 -2245 698 0 697 0 -3 1360 -3 1360 1130 0 1131 0 0 -1355 0 -1355 705 0 705 0 0 3240 0 3240 -705 0 -705 0 0 -1355z" /></svg>
                    <span class="logo-title">TrakHound<span class="logo-subtitle">Instance</span></span>
                </div>
                <div class="instance">
                    @if (!string.IsNullOrEmpty(instanceName))
                    {
                        <span class="instance-name">@instanceName</span>
                        <span aria-hidden="true">·</span>
                    }
                    <span id="reconnection-panel-host" class="instance-host"></span>
                </div>
            </div>

            <div class="status-icon" aria-hidden="true">
                <div class="status-ring"></div>
            </div>

            <div class="information">
                <h1 id="reconnection-panel-title" class="title">Connection Lost</h1>
                <p id="reconnection-panel-since" class="since"></p>
                <p id="reconnection-panel-description" class="description">Lost connection to the server</p>
                <p id="reconnection-panel-label" class="status-label" aria-live="polite"></p>

                <div class="buttons">
                    <button id="reconnection-panel-retry" type="button" class="button primary">Retry Now</button>
                    <button id="reconnection-panel-reload" type="button" class="button">Reload Page</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private string instanceName;


    protected override void OnInitialized()
    {
        instanceName = !string.IsNullOrEmpty(instanceConfiguration?.Name) ? instanceConfiguration.Name : instanceConfiguration?.InstanceId;
    }

}
