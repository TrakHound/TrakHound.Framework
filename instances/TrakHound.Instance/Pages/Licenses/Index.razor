    private async Task Load()
    {
        loading = true;
        loadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            // License Managers read from disk, so load off of the UI thread
            var result = await Task.Run(LoadLicenses);

            publisherIds = result.PublisherIds;
            multiplePublishers = result.PublisherIds.Count > 1;

            // Group by Product, then the License that expires last first (the one most likely in use)
            licenseTableItems = result.Licenses.OrderBy(o => o.ProductId).ThenByDescending(o => o.ExpirationDate).ToList();
            assignmentTableItems = result.Assignments.OrderBy(o => o.IsValid).ThenBy(o => o.ProductId).ThenBy(o => o.Description).ToList();

            // Keep the selected Publisher if it still exists
            if (selectedPublisherId == null || !result.PublisherIds.Contains(selectedPublisherId))
            {
                selectedPublisherId = result.PublisherIds.FirstOrDefault();
            }

            // Every Publisher's Licenses are issued for the same Device ID
            var deviceIdInformation = TrakHoundDeviceId.GetInformation();
            deviceId = deviceIdInformation.DeviceId;
            deviceIdWarning = deviceIdInformation.Warning;
        }
        catch (Exception ex)
        {
            // Show the error instead of staying on 'Loading..'
            loadError = ex.Message;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static LoadResult LoadLicenses()
    {
        var result = new LoadResult();
        var now = DateTime.UtcNow;

        var licenseManagers = TrakHoundLicenseManagers.Get();
        if (!licenseManagers.IsNullOrEmpty())
        {
            foreach (var licenseManager in licenseManagers)
            {
                licenseManager.Refresh();
                result.PublisherIds.Add(licenseManager.PublisherId);

                var licenseInformations = licenseManager.GetLicenses();
                if (!licenseInformations.IsNullOrEmpty())
                {
                    foreach (var licenseInformation in licenseInformations)
                    {
                        var validationResult = licenseManager.CheckLicenseCode(licenseInformation.LicenseCode);
                        var expiresIn = licenseInformation.ExpirationDate - now;

                        var item = new LicenseTableItem();
                        item.IsValid = validationResult.IsValid;
                        (item.Status, item.StatusClass) = GetLicenseStatus(validationResult.IsValid, expiresIn);
                        item.PublisherId = licenseManager.PublisherId;
                        item.ProductId = licenseInformation.ProductId;
                        item.DeviceId = licenseInformation.DeviceId;
                        item.LicenseCode = licenseInformation.LicenseCode;
                        item.Description = licenseInformation.Description;
                        item.AssignmentCount = licenseInformation.AssignmentCount;
                        item.AssignmentLimit = licenseInformation.AssignmentLimit;
                        item.ExpiresIn = expiresIn;
                        item.ExpirationDate = licenseInformation.ExpirationDate;
                        item.Message = validationResult.Message;
                        item.IsPermanent = licenseInformation.IsPermanent;
                        result.Licenses.Add(item);
                    }
                }

                var assignmentInformations = licenseManager.GetAssignments();
                if (!assignmentInformations.IsNullOrEmpty())
                {
                    foreach (var assignmentInformation in assignmentInformations)
                    {
                        var validationResult = licenseManager.CheckAssignment(assignmentInformation.AssignmentId);

                        var item = new AssignmentTableItem();
                        item.IsValid = validationResult.IsValid;
                        item.Status = validationResult.IsValid ? "Active" : "Inactive";
                        item.StatusClass = validationResult.IsValid ? "active" : "inactive";
                        item.AssignmentId = assignmentInformation.AssignmentId;
                        item.PublisherId = licenseManager.PublisherId;
                        item.ProductId = assignmentInformation.ProductId;
                        item.DeviceId = assignmentInformation.DeviceId;
                        item.LicenseCode = assignmentInformation.LicenseCode;
                        item.Message = validationResult.Message;
                        item.Description = assignmentInformation.Description;
                        result.Assignments.Add(item);
                    }
                }
            }
        }

        return result;
    }

    private static (string Status, string StatusClass) GetLicenseStatus(bool isValid, TimeSpan expiresIn)
    {
        if (expiresIn <= TimeSpan.Zero) return ("Expired", "expired");
        if (!isValid) return ("Invalid", "inactive");
        if (expiresIn < _expiringSoon) return ("Expiring", "expiring");
        return ("Active", "active");
    }


    // Summary

    private IEnumerable<SummaryTile> GetSummaryTiles()
    {
        var licenses = licenseTableItems ?? Enumerable.Empty<LicenseTableItem>();
        var assignments = assignmentTableItems ?? Enumerable.Empty<AssignmentTableItem>();
        var total = licenses.Count();

        var active = licenses.Count(o => o.StatusClass == "active");
        var expiring = licenses.Count(o => o.StatusClass == "expiring");
        var expired = licenses.Count(o => o.StatusClass == "expired" || o.StatusClass == "inactive");
        var unlicensed = assignments.Count(o => !o.IsValid);

        yield return LicenseTile("active", "Active", "fa-circle-check", active, $"of {Plural(total, "License")}");
        yield return LicenseTile("expiring", "Expiring", "fa-clock", expiring, $"within {_expiringSoon.TotalDays} days");
        yield return LicenseTile("expired", "Expired", "fa-circle-xmark", expired, expired > 0 ? "Renew or Remove" : "None");
        yield return new SummaryTile
        {
            Label = "Unlicensed",
            Icon = "fa-link-slash",
            Value = unlicensed,
            Detail = $"of {Plural(assignments.Count(), "Assignment")}",
            Title = "Show Assignments without a valid License",
            StatusClass = unlicensed > 0 ? "inactive" : null,
            Selected = unlicensedOnly,
            Clicked = () =>
            {
                unlicensedOnly = !unlicensedOnly;
                licenseFilter = null;
                if (!IsAssignments) navigationManager.NavigateTo("_admin/licenses/assignments");
            }
        };
    }

