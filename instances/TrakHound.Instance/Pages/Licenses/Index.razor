        await javascript.CopyClipboard(deviceId);
        notificationService.AddNotification(NotificationType.Success, "Device ID Copied");
    }

    private async Task CopyClipboard(string value)
    {
        await javascript.CopyClipboard(value);
        notificationService.AddNotification(NotificationType.Success, "Copied to Clipboard");
    }

    private void ToggleReveal(string licenseCode)
    {
        if (!revealedLicenseCodes.Remove(licenseCode)) revealedLicenseCodes.Add(licenseCode);
    }


    // Formatting

    // Show only the first and last groups (ex. 91870-•••••-CD2YX) so codes aren't exposed in screenshots
    private static string MaskLicenseCode(string licenseCode)
    {
        if (string.IsNullOrEmpty(licenseCode)) return licenseCode;

        var groups = licenseCode.Split('-');
        if (groups.Length >= 3) return $"{groups[0]}-•••••-{groups[^1]}";
        if (licenseCode.Length > 8) return $"{licenseCode[..4]}••••{licenseCode[^4..]}";
        return new string('•', licenseCode.Length);
    }

    private static string GetExpiration(TimeSpan timeSpan)
    {
        if (timeSpan <= TimeSpan.Zero) return $"Expired {FormatDuration(timeSpan.Negate())} ago";
        return $"In {FormatDuration(timeSpan)}";
    }

    private static string FormatDuration(TimeSpan timeSpan)
    {
        if (timeSpan.TotalDays >= 60) return Plural((int)(timeSpan.TotalDays / 30), "month");
        if (timeSpan.TotalDays >= 2) return Plural((int)timeSpan.TotalDays, "day");
        if (timeSpan.TotalHours >= 2) return Plural((int)timeSpan.TotalHours, "hour");
        if (timeSpan.TotalMinutes >= 2) return Plural((int)timeSpan.TotalMinutes, "minute");
        return "a moment";
    }

    private static string Plural(int value, string unit) => $"{value} {unit}{(value == 1 ? "" : "s")}";

}
