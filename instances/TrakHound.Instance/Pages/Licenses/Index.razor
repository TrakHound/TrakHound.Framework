    // Runs an action against a Publisher's License Manager and reports the result
    private async Task RunLicenseAction(string publisherId, Action<ITrakHoundLicenseManager> action, string successTitle, string errorTitle, string description)
    {
        TrakHound.Instance.Security.TrakHoundAdminContext.DemandWrite(TrakHound.Instance.Security.TrakHoundAdminSecurity.Licenses);

        var licenseManager = TrakHoundLicenseManagers.Get(publisherId);
        if (licenseManager == null)
        {
            notificationService.AddNotification(NotificationType.Error, errorTitle, $"Publisher '{publisherId}' not found");
            return;
        }

        try
        {
            action(licenseManager);
            notificationService.AddNotification(NotificationType.Success, successTitle, description);
        }
        catch (Exception ex)
        {
            notificationService.AddNotification(NotificationType.Error, errorTitle, ex.Message);
        }

        await Load();
    }


    // Assign

    private async Task AssignmentLicenseChanged(AssignmentTableItem item, string licenseCode)
    {
        TrakHound.Instance.Security.TrakHoundAdminContext.DemandWrite(TrakHound.Instance.Security.TrakHoundAdminSecurity.Licenses);

        if (licenseCode == null || licenseCode == item.LicenseCode) return;

        var licenseManager = TrakHoundLicenseManagers.Get(item.PublisherId);
        if (licenseManager != null)
        {
            try
            {
                var result = licenseManager.AssignLicense(licenseCode, item.AssignmentId);
                if (result.Success)
                {
                    notificationService.AddNotification(NotificationType.Success, "License Assigned", item.Description ?? item.AssignmentId);
                }
                else
                {
                    notificationService.AddNotification(NotificationType.Error, "Assign License Failed", result.Message);
                }
            }
            catch (Exception ex)
            {
                notificationService.AddNotification(NotificationType.Error, "Assign License Failed", ex.Message);
            }

            await Load();
        }
    }

    // Only valid Licenses for the same Product (plus the currently assigned License, so it still displays)
    private IEnumerable<LicenseTableItem> GetAssignableLicenses(AssignmentTableItem item)
    {
        if (!string.IsNullOrEmpty(item.ProductId) && !licenseTableItems.IsNullOrEmpty())
        {
            return licenseTableItems.Where(o => o.ProductId == item.ProductId && o.PublisherId == item.PublisherId && (o.IsValid || o.LicenseCode == item.LicenseCode));
        }

        return null;
    }


