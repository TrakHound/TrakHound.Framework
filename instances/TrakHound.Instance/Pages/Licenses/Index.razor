@page "/_admin/licenses"
@page "/_admin/licenses/{Section}"
@attribute [TrakHound.Instance.Security.AdminResource(TrakHound.Instance.Security.TrakHoundAdminSecurity.Licenses)]
@implements IDisposable
@inject JavascriptService javascript
@inject NavigationManager navigationManager
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using TrakHound.Blazor.Components
@using TrakHound.Blazor.Services
@using TrakHound.Licenses

<TrakHoundPageTitle Text="@(IsAssignments ? "Assignments - Licenses" : "Licenses")" />
<AreaBreadcrumbs Items="@GetBreadcrumbs()" />

<AreaLayout Icon="fa-solid fa-sharp fa-key" Title="Licenses" Subtitle="Manage Licenses" Link="_admin/licenses">
    <Tools>
        @* Publisher, Device ID and Refresh (for both sections) *@
        <div class="device-panel">
            @if (multiplePublishers)
            {
                <label>Publisher</label>
                <RadzenDropDown TValue="string" Data="@publisherIds" @bind-Value="@selectedPublisherId" />
            }
            <label>Device ID</label>
            <div class="device-id-output" title="@GetDeviceIdSourceText()">@deviceId</div>
            <button class="btn btn-light btn-icon" title="Copy Device ID" disabled="@string.IsNullOrEmpty(deviceId)" @onclick="CopyDeviceId"><span class="icon fa-solid fa-sharp fa-copy"></span></button>
        </div>

        @if (!loading)
        {
            <button class="btn btn-light btn-icon" title="Refresh" aria-label="Refresh the Licenses" @onclick="Load"><span class="icon fa-solid fa-sharp fa-rotate-right"></span></button>
        }
        else
        {
            <button class="btn btn-light btn-icon disabled" title="Loading.." disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span></button>
        }
    </Tools>
    <Nav>
        <AreaNavItem Href="_admin/licenses" Icon="fa-solid fa-sharp fa-key" Label="Licenses" Count="@licenseTableItems?.Count()" Match="NavLinkMatch.All" />
        <AreaNavItem Href="_admin/licenses/assignments" Icon="fa-solid fa-sharp fa-link" Label="Assignments" Count="@assignmentTableItems?.Count()" />
    </Nav>
    <ChildContent>
<div class="licenses-page">

    @if (deviceIdWarning != null)
    {
        <div class="device-id-warning"><span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>@deviceIdWarning</div>
    }

    @if (loadError != null)
    {
        <div class="content-panel">
            <div class="empty-state">
                <span class="empty-state-icon error fa-solid fa-sharp fa-circle-exclamation"></span>
                <span class="empty-state-title">Unable to load Licenses</span>
                <span class="empty-state-description">@loadError</span>
            </div>
        </div>
    }
    else if (!loading)
    {
        <div class="content-panel">

            @* Summary : click a tile to filter the table it applies to *@
            <div class="summary-tiles">
                @foreach (var tile in GetSummaryTiles())
                {
                    <button class="summary-tile @tile.StatusClass @(tile.Selected ? "selected" : null) @(tile.Value > 0 ? null : "zero")" title="@tile.Title" @onclick="tile.Clicked">
                        <span class="tile-label"><span class="icon fa-solid fa-sharp @tile.Icon"></span>@tile.Label</span>
                        <span class="tile-value">@tile.Value</span>
                        <span class="tile-detail">@tile.Detail</span>
                    </button>
                }
            </div>

            <div class="tabs-panel">
                @if (!IsAssignments)
                {
                        <div class="licenses-panel">
                            <div class="tab-toolbar">
                                <button class="admin-write btn btn-primary" @onclick="AddLicenseClicked"><span class="icon fa-solid fa-sharp fa-plus"></span>Add License</button>
                                <button class="admin-write btn btn-light" title="Paste or open a License File to add multiple Licenses" @onclick="ImportClicked"><span class="icon fa-solid fa-sharp fa-file-import"></span>Import</button>
                                @* On the TrakHound website : where a License Code comes from *@
                                <a class="btn btn-light" href="@TrakHoundWebsite.LicenseRequestUrl" target="_blank" rel="noopener" title="Request a trial or subscription License from TrakHound"><span class="icon fa-solid fa-sharp fa-arrow-up-right-from-square"></span>Request a License</a>

                                @if (licenseFilter != null)
                                {
                                    <span class="filter-chip">
                                        Showing @GetLicenseFilterText() Licenses
                                        <button class="btn-chip-clear" title="Show all Licenses" @onclick="() => licenseFilter = null"><span class="icon fa-solid fa-sharp fa-xmark"></span></button>
                                    </span>
                                }
                            </div>
                            <div class="table-panel">

                                @if (!licenseTableItems.IsNullOrEmpty())
                                {
                                    <RadzenDataGrid Data="@GetFilteredLicenses()" TItem="LicenseTableItem" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true" RowRender="LicenseRowRender">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="Status" Title="Status" Width="120px">
                                                <Template Context="context">
                                                    <span class="status-badge @context.StatusClass" title="@context.Message">
                                                        <span class="status-dot"></span>@context.Status
                                                    </span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="ProductId" Title="Product" MinWidth="200px">
                                                <Template Context="context">
                                                    <div class="value-with-actions">
                                                        <span class="value" title="@context.ProductId">@context.ProductId</span>
                                                        <button class="btn btn-light btn-cell" title="Copy Product ID" @onclick="() => CopyClipboard(context.ProductId)"><span class="icon fa-solid fa-sharp fa-copy"></span></button>
                                                    </div>
                                                    @if (context.Description != null)
                                                    {
                                                        <span class="value sub-value" title="@context.Description">@context.Description</span>
                                                    }
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="LicenseCode" Title="License Code" Width="260px">
                                                <Template Context="context">
                                                    @{
                                                        var revealed = revealedLicenseCodes.Contains(context.LicenseCode);
                                                    }
                                                    <div class="value-with-actions">
                                                        <span class="value code">@(revealed ? context.LicenseCode : MaskLicenseCode(context.LicenseCode))</span>
                                                        <button class="btn btn-light btn-cell" title="@(revealed ? "Hide License Code" : "Show License Code")" @onclick="() => ToggleReveal(context.LicenseCode)"><span class="icon fa-solid fa-sharp @(revealed ? "fa-eye-slash" : "fa-eye")"></span></button>
                                                        <button class="btn btn-light btn-cell" title="Copy License Code" @onclick="() => CopyClipboard(context.LicenseCode)"><span class="icon fa-solid fa-sharp fa-copy"></span></button>
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="AssignmentCount" Title="Assignments" Width="135px">
                                                <Template Context="context">
                                                    <span class="usage-text">@context.AssignmentCount / @context.AssignmentLimit</span>
                                                    <span class="usage-bar @(context.AssignmentCount >= context.AssignmentLimit ? "full" : null)"><span class="usage-fill" style="width: @GetUsagePercent(context)%"></span></span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="ExpirationDate" Title="Expires" Width="170px">
                                                <Template Context="context">
                                                    @if (context.IsPermanent)
                                                    {
                                                        <span class="expires @context.StatusClass">Never</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="expires @context.StatusClass">@GetExpiration(context.ExpiresIn)</span>
                                                        <span class="expires-date">@context.ExpirationDate.ToString("MMM d, yyyy")</span>
                                                    }
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Property="PublisherId" Title="Publisher" Width="110px" Visible="@multiplePublishers" />
                                            <RadzenDataGridColumn TItem="LicenseTableItem" Title="Actions" Width="150px" Sortable="false">
                                                <Template Context="context">
                                                    <div class="table-buttons-container">
                                                        <button class="admin-write btn btn-sm btn-light btn-action" title="Edit Description" @onclick="() => EditDescriptionClicked(context)"><span class="icon fa-solid fa-sharp fa-pen"></span></button>
                                                        <button class="admin-write btn btn-sm btn-light btn-action" title="Renew License" @onclick="() => RenewLicenseClicked(context)"><span class="icon fa-solid fa-sharp fa-rotate"></span></button>
                                                        <button class="admin-write btn btn-sm btn-light btn-action" title="Unassign All" disabled="@(context.AssignmentCount == 0)" @onclick="() => UnassignAllClicked(context)"><span class="icon fa-solid fa-sharp fa-link-slash"></span></button>
                                                        <button class="admin-write btn btn-sm btn-light btn-action btn-danger-icon" title="Remove License" @onclick="() => RemoveLicenseClicked(context)"><span class="icon fa-solid fa-sharp fa-trash"></span></button>
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <span class="empty-state-icon fa-solid fa-sharp fa-key"></span>
                                        <span class="empty-state-title">No Licenses</span>
                                        <span class="empty-state-description">Add a License using its Product ID and License Code, or Import a License File</span>
                                        <span class="empty-state-links">
                                            <a href="@TrakHoundWebsite.LicenseRequestUrl" target="_blank" rel="noopener">Request a License</a>
                                            <a href="@TrakHoundWebsite.LicensingGuide" target="_blank" rel="noopener">Licensing Guide</a>
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>
                }
                else
                {
                        <div class="assignments-panel">

                            @if (unlicensedOnly)
                            {
                                <div class="tab-toolbar">
                                    <span class="filter-chip">
                                        Showing Unlicensed Assignments
                                        <button class="btn-chip-clear" title="Show all Assignments" @onclick="() => unlicensedOnly = false"><span class="icon fa-solid fa-sharp fa-xmark"></span></button>
                                    </span>
                                </div>
                            }

                            <div class="table-panel">

                                @if (!assignmentTableItems.IsNullOrEmpty())
                                {
                                    <RadzenDataGrid Data="@GetFilteredAssignments()" TItem="AssignmentTableItem" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true" RowRender="AssignmentRowRender">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Property="Status" Title="Status" Width="110px">
                                                <Template Context="context">
                                                    <span class="status-badge @context.StatusClass" title="@context.Message">
                                                        <span class="status-dot"></span>@context.Status
                                                    </span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Property="Description" Title="Description" MinWidth="260px">
                                                <Template Context="context">
                                                    <span class="value" title="@context.Description">@context.Description</span>
                                                    <span class="value sub-value code" title="Assignment ID">@context.AssignmentId</span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Property="ProductId" Title="Product" Width="240px">
                                                <Template Context="context">
                                                    <div class="value-with-actions">
                                                        <span class="value" title="@context.ProductId">@context.ProductId</span>
                                                        <button class="btn btn-light btn-cell" title="Copy Product ID" @onclick="() => CopyClipboard(context.ProductId)"><span class="icon fa-solid fa-sharp fa-copy"></span></button>
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Property="LicenseCode" Title="License" Width="300px" CssClass="license-select">
                                                <Template Context="context">
                                                    <RadzenDropDown TValue="string" Data="@GetAssignableLicenses(context)" TextProperty="DisplayText" ValueProperty="LicenseCode" Value="@context.LicenseCode" ValueChanged="(licenseCode) => AssignmentLicenseChanged(context, licenseCode)" Placeholder="Select License..." />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Property="PublisherId" Title="Publisher" Width="100px" Visible="@multiplePublishers" />
                                            <RadzenDataGridColumn TItem="AssignmentTableItem" Title="Actions" Width="80px" Sortable="false">
                                                <Template Context="context">
                                                    <div class="table-buttons-container">
                                                        <button class="admin-write btn btn-sm btn-light btn-action btn-danger-icon" title="Unassign License" disabled="@string.IsNullOrEmpty(context.LicenseCode)" @onclick="() => UnassignClicked(context)"><span class="icon fa-solid fa-sharp fa-link-slash"></span></button>
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <span class="empty-state-icon fa-solid fa-sharp fa-link"></span>
                                        <span class="empty-state-title">No Assignments</span>
                                        <span class="empty-state-description">Assignments appear here when licensed Workers, APIs, or Services request a License</span>
                                    </div>
                                }

                            </div>
                        </div>
                }
            </div>

        </div>
    }
    else
    {
        <div class="loading-panel">
            <Loading Message="Loading Licenses..." Delay="false" />
        </div>
    }

</div>
    </ChildContent>
</AreaLayout>


<Modal Class="renew-license-modal" Visible="@renewModalVisible">
    <HeaderContent>
        <span class="modal-header-icon fa-solid fa-sharp fa-rotate"></span>
        <span class="modal-header-title">Renew License</span>
    </HeaderContent>
    <BodyContent>
        <div class="renew-license-panel">

            @if (renewItem != null)
            {
                <div class="renew-license-table">
                    <table>
                        <tbody>
                            <tr>
                                <td class="label">Product ID</td>
                                <td class="value">@renewItem.ProductId</td>
                            </tr>
                            @if (renewItem.Description != null)
                            {
                                <tr>
                                    <td class="label">Description</td>
                                    <td class="value">@renewItem.Description</td>
                                </tr>
                            }
                            <tr>
                                <td class="label">Current License</td>
                                <td class="value">@MaskLicenseCode(renewItem.LicenseCode)</td>
                            </tr>
                            <tr>
                                <td class="label">Device ID</td>
                                <td class="value">@renewItem.DeviceId</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            <div class="renew-license-input">
                <TextBox @bind-Value="renewLicenseCode" PlaceHolder="New License Code" />
            </div>

            @if (renewError != null)
            {
                <div class="modal-error"><span class="icon fa-solid fa-sharp fa-circle-exclamation"></span>@renewError</div>
            }
        </div>
    </BodyContent>
    <FooterContent>

        @if (!renewLoading)
        {
            <button class="btn btn-secondary" @onclick="ModalCancelClicked"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
            <button class="admin-write btn btn-primary" disabled="@string.IsNullOrWhiteSpace(renewLicenseCode)" @onclick="ModalRenewLicenseClicked"><span class="icon fa-solid fa-sharp fa-check"></span>Renew</button>
        }
        else
        {
            <button class="admin-write btn btn-primary disabled" disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span>Renewing..</button>
        }

    </FooterContent>
</Modal>

<Modal Class="description-modal" Visible="@descriptionVisible">
    <HeaderContent>
        <span class="modal-header-icon fa-solid fa-sharp fa-pen"></span>
        <span class="modal-header-title">Edit Description</span>
    </HeaderContent>
    <BodyContent>
        <div class="description-panel">

            @if (descriptionItem != null)
            {
                <div class="description-table">
                    <table>
                        <tbody>
                            <tr>
                                <td class="label">Product ID</td>
                                <td class="value">@descriptionItem.ProductId</td>
                            </tr>
                            <tr>
                                <td class="label">License</td>
                                <td class="value">@MaskLicenseCode(descriptionItem.LicenseCode)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            <div class="add-license-input">
                <label>Description</label>
                <TextBox @bind-Value="descriptionText" PlaceHolder="ex. Line 3 machines, PO-4471" Submitted="ModalSaveDescriptionClicked" />
            </div>

            @if (descriptionError != null)
            {
                <div class="modal-error"><span class="icon fa-solid fa-sharp fa-circle-exclamation"></span>@descriptionError</div>
            }
        </div>
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="ModalCancelClicked"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
        <button class="admin-write btn btn-primary" @onclick="ModalSaveDescriptionClicked"><span class="icon fa-solid fa-sharp fa-check"></span>Save</button>
    </FooterContent>
</Modal>

<Modal Class="add-license-modal" Visible="@addVisible">
    <HeaderContent>
        <span class="modal-header-icon fa-solid fa-sharp fa-plus"></span>
        <span class="modal-header-title">Add License</span>
    </HeaderContent>
    <BodyContent>
        <div class="add-license-panel">

            <div class="add-license-table">
                <table>
                    <tbody>
                        <tr>
                            <td class="label">Device ID</td>
                            <td class="value code">@deviceId</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="add-license-input">
                <label>Publisher ID</label>
                <TextBox @bind-Value="addPublisherId" PlaceHolder="ex. trakhound" />
            </div>
            <div class="add-license-input">
                <label>Product ID</label>
                <TextBox @bind-Value="addProductId" PlaceHolder="ex. trakhound.sqlserver" />
            </div>
            <div class="add-license-input">
                <label>License Code</label>
                <TextBox @bind-Value="addLicenseCode" PlaceHolder="XXXXX-XXXXX-XXXXX" />
            </div>
            <div class="add-license-input">
                <label>Description (optional)</label>
                <TextBox @bind-Value="addDescription" PlaceHolder="ex. Line 3 machines, PO-4471" />
            </div>

            @if (addError != null)
            {
                <div class="modal-error"><span class="icon fa-solid fa-sharp fa-circle-exclamation"></span>@addError</div>
            }
        </div>
    </BodyContent>
    <FooterContent>

        @if (!addLoading)
        {
            <button class="btn btn-secondary" @onclick="ModalCancelClicked"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
            <button class="admin-write btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(addPublisherId) || string.IsNullOrWhiteSpace(addProductId) || string.IsNullOrWhiteSpace(addLicenseCode))" @onclick="ModalAddLicenseClicked"><span class="icon fa-solid fa-sharp fa-plus"></span>Add License</button>
        }
        else
        {
            <button class="admin-write btn btn-primary disabled" disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span>Adding..</button>
        }

    </FooterContent>
</Modal>

<Modal Class="import-license-modal" Visible="@importVisible">
    <HeaderContent>
        <span class="modal-header-icon fa-solid fa-sharp fa-file-import"></span>
        <span class="modal-header-title">Import Licenses</span>
    </HeaderContent>
    <BodyContent>
        <div class="import-license-panel">

            @if (!importComplete)
            {
                <div class="import-description">Paste a License File (JSON) or one <span class="code">ProductId LicenseCode</span> pair per line</div>

                <textarea class="form-control import-text" rows="8" spellcheck="false" autocomplete="off" disabled="@importLoading"
                          placeholder="@_importPlaceHolder"
                          @bind="importText" @bind:event="oninput" @bind:after="ParseImport"></textarea>

                <div class="import-toolbar">
                    <div class="import-file-button btn btn-light @(importLoading ? "disabled" : "")">
                        <span class="icon fa-solid fa-sharp fa-folder-open"></span>Open File
                        <InputFile OnChange="ImportFileSelected" accept="@($"{TrakHoundLicenseFile.FileExtension},.txt")" title="" class="import-file-input" />
                    </div>
                    <span class="import-summary">@GetImportSummary()</span>
                </div>
            }

            @if (!importErrors.IsNullOrEmpty())
            {
                <div class="import-errors">
                    @foreach (var error in importErrors)
                    {
                        <div class="modal-error"><span class="icon fa-solid fa-sharp fa-circle-exclamation"></span>@error</div>
                    }
                </div>
            }

            @if (!importRows.IsNullOrEmpty())
            {
                <div class="import-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Product</th>
                                <th>License Code</th>
                                <th>Publisher</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in importRows)
                            {
                                <tr>
                                    <td class="status">
                                        <span class="status-badge @GetImportStatusClass(row.Status)">
                                            <span class="status-dot"></span>@GetImportStatusText(row.Status)
                                        </span>
                                        @if (!string.IsNullOrEmpty(row.Message))
                                        {
                                            <span class="status-message">@row.Message</span>
                                        }
                                    </td>
                                    <td class="product" title="@row.ProductId">
                                        @row.ProductId
                                        @if (row.Description != null)
                                        {
                                            <span class="product-description" title="@row.Description">@row.Description</span>
                                        }
                                    </td>
                                    <td class="code">@MaskLicenseCode(row.LicenseCode)</td>
                                    <td>@row.PublisherId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </BodyContent>
    <FooterContent>

        @if (importComplete)
        {
            <button class="btn btn-primary" @onclick="ImportCloseClicked"><span class="icon fa-solid fa-sharp fa-check"></span>Done</button>
        }
        else if (!importLoading)
        {
            var readyCount = importRows.Count(o => o.Status == ImportStatus.Ready);

            <button class="btn btn-secondary" @onclick="ImportCloseClicked"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
            <button class="admin-write btn btn-primary" disabled="@(readyCount == 0)" @onclick="ModalImportClicked"><span class="icon fa-solid fa-sharp fa-file-import"></span>Import@(readyCount > 0 ? $" ({readyCount})" : "")</button>
        }
        else
        {
            <button class="admin-write btn btn-primary disabled" disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span>Importing..</button>
        }

    </FooterContent>
</Modal>

<Modal Class="confirm-modal" Visible="@(confirmAction != null)">
    <HeaderContent>
        <span class="modal-header-icon fa-solid fa-sharp fa-triangle-exclamation"></span>
        <span class="modal-header-title">@confirmTitle</span>
    </HeaderContent>
    <BodyContent>
        <div class="confirm-panel">

            <div class="confirm-message-container">
                <span class="confirm-message">@confirmMessage</span>
            </div>

            @if (!confirmDetails.IsNullOrEmpty())
            {
                <div class="confirm-table">
                    <table>
                        <tbody>
                            @foreach (var detail in confirmDetails)
                            {
                                <tr>
                                    <td class="label">@detail.Key</td>
                                    <td class="value">@detail.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </BodyContent>
    <FooterContent>

        @if (!confirmLoading)
        {
            <button class="btn btn-secondary" @onclick="ModalCancelClicked"><span class="icon fa-solid fa-sharp fa-xmark"></span>Cancel</button>
            <button class="admin-write btn btn-danger" @onclick="ModalConfirmClicked"><span class="icon fa-solid fa-sharp @confirmIcon"></span>@confirmLabel</button>
        }
        else
        {
            <button class="btn btn-danger disabled" disabled><span class="icon fa-solid fa-sharp fa-loader spin"></span>@(confirmLabel)..</button>
        }

    </FooterContent>
</Modal>

<Notifications Items="@notificationService.Notifications" OnDismiss="notificationService.Dismiss" />

@code {

    private static readonly TimeSpan _expiringSoon = TimeSpan.FromDays(30);
    private const string _defaultPublisherId = TrakHoundLicenseManagers.DefaultPublisherId;
    private const long _maxImportFileSize = 1024 * 1024; // 1 MB
    private const string _importPlaceHolder = "{\n  \"publisherId\": \"trakhound\",\n  \"deviceId\": \"...\",\n  \"licenses\": [\n    { \"productId\": \"...\", \"licenseCode\": \"...\", \"description\": \"...\" }\n  ]\n}";

    private TrakHound.Instance.Components.NotificationService notificationService;

    private IEnumerable<string> publisherIds;
    private string selectedPublisherId;
    private string deviceId;
    private string deviceIdWarning;

    private IEnumerable<LicenseTableItem> licenseTableItems;
    private IEnumerable<AssignmentTableItem> assignmentTableItems;
    private readonly HashSet<string> revealedLicenseCodes = new HashSet<string>();
    private bool multiplePublishers;

    // The section (from the route) : "assignments", or the Licenses
    [Parameter]
    public string Section { get; set; }

    private bool IsAssignments => string.Equals(Section, "assignments", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<BreadcrumbItem> GetBreadcrumbs() => IsAssignments ? [new("Assignments")] : [];

