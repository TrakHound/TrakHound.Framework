    private string GetImportSummary()
    {
        if (importRows.IsNullOrEmpty()) return importErrors.IsNullOrEmpty() ? null : "No Licenses found";

        var ready = importRows.Count(o => o.Status == ImportStatus.Ready);
        var skipped = importRows.Count - ready;
        return $"{Plural(importRows.Count, "License")} found" + (skipped > 0 ? $", {skipped} will be skipped" : "");
    }

    private static string GetImportStatusText(ImportStatus status) => status switch
    {
        ImportStatus.Ready => "Ready",
        ImportStatus.Exists => "Already Added",
        ImportStatus.UnknownPublisher => "Invalid Publisher",
        ImportStatus.WrongDevice => "Wrong Device",
        ImportStatus.Added => "Added",
        _ => "Failed"
    };

    private static string GetImportStatusClass(ImportStatus status) => status switch
    {
        ImportStatus.Ready => "ready",
        ImportStatus.Added => "active",
        ImportStatus.Exists => "skipped",
        _ => "inactive"
    };


