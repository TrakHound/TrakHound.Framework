    private async Task ImportFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null) return;

        if (file.Size > _maxImportFileSize)
        {
            importErrors = new List<string> { $"'{file.Name}' is too large to be a License File" };
            importRows = new List<ImportRow>();
            return;
        }

        try
        {
            using (var reader = new StreamReader(file.OpenReadStream(_maxImportFileSize)))
            {
                importText = await reader.ReadToEndAsync();
            }

            ParseImport();
        }
        catch (Exception ex)
        {
            importErrors = new List<string> { $"Could not read '{file.Name}' : {ex.Message}" };
            importRows = new List<ImportRow>();
        }
    }

    // Parses the pasted text and checks each License against what is already loaded (nothing is added yet)
    private void ParseImport()
    {
        var licenseFile = TrakHoundLicenseFile.Parse(importText);
        var rows = new List<ImportRow>();

        foreach (var entry in licenseFile.Licenses)
        {
            var row = new ImportRow();
            row.PublisherId = entry.PublisherId ?? selectedPublisherId ?? _defaultPublisherId;
            row.ProductId = entry.ProductId;
            row.LicenseCode = entry.LicenseCode;
            row.Description = entry.Description;

            // Checked without creating the Publisher's Manager, so a preview doesn't add a Publisher
            if (!TrakHoundLicenseManagers.IsValidPublisherId(row.PublisherId))
            {
                row.Status = ImportStatus.UnknownPublisher;
                row.Message = $"'{row.PublisherId}' isn't a valid Publisher ID";
            }
            else
            {
                if (licenseTableItems != null && licenseTableItems.Any(o => o.PublisherId == row.PublisherId && o.LicenseCode == TrakHoundLicenseCode.Format(row.LicenseCode)))
                {
                    row.Status = ImportStatus.Exists;
                }
                else if (entry.DeviceId != null && deviceId != null && TrakHoundDeviceId.Normalize(entry.DeviceId) != deviceId)
                {
                    row.Status = ImportStatus.WrongDevice;
                    row.Message = $"Issued for Device '{entry.DeviceId}'";
                }
                else
                {
                    row.Status = ImportStatus.Ready;
                }
            }

            rows.Add(row);
        }

        importRows = rows;
        importErrors = licenseFile.Errors;
    }

    private async Task ModalImportClicked()
    {
        TrakHound.Instance.Security.TrakHoundAdminContext.DemandWrite(TrakHound.Instance.Security.TrakHoundAdminSecurity.Licenses);

        var rows = importRows.Where(o => o.Status == ImportStatus.Ready).ToList();
        if (rows.Count == 0) return;

        importLoading = true;
        await InvokeAsync(StateHasChanged);

        // License Managers write to disk, so import off of the UI thread. Each License is added on its own so one bad code doesn't stop the rest.
        await Task.Run(() =>
        {
            foreach (var row in rows)
            {
                try
                {
                    var licenseManager = TrakHoundLicenseManagers.Get(row.PublisherId);
                    var information = licenseManager?.AddLicense(row.ProductId, licenseManager.GetDeviceId(), row.LicenseCode, row.Description);
                    if (information != null)
                    {
                        row.Status = ImportStatus.Added;
                        row.Message = null;
                    }
                    else
                    {
                        row.Status = ImportStatus.Failed;
                        row.Message = "Check the Product ID and License Code";
                    }
                }
                catch (Exception ex)
                {
                    row.Status = ImportStatus.Failed;
                    row.Message = ex.Message;
                }
            }
        });

        var added = rows.Count(o => o.Status == ImportStatus.Added);
        var failed = rows.Count(o => o.Status == ImportStatus.Failed);
        var skipped = importRows.Count - rows.Count;

        var description = $"{added} added" + (skipped > 0 ? $", {skipped} skipped" : "") + (failed > 0 ? $", {failed} failed" : "");
        if (failed > 0) notificationService.AddNotification(NotificationType.Error, "Licenses Imported with Errors", description);
        else notificationService.AddNotification(NotificationType.Success, "Licenses Imported", description);

        importLoading = false;
        importComplete = true;

        await Load();
    }

