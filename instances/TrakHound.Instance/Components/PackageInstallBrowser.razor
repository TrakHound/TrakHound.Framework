@using TrakHound.Packages;
@implements IDisposable

<div class="package-install-browser">
    <div class="package-install-browser-content @(selectedPackage != null ? "has-selection" : "")">
        <div class="package-toolbar">
            <div class="package-toolbar-content">
                <div class="package-toolbar-buttons">

                    @if (!loading)
                    {
                        <button class="btn-search btn-command btn" @onclick="SearchClicked"><span class="icon fas fa-magnifying-glass"></span>Search</button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-search btn-loading" disabled><span class="icon loading-icon fa-regular fa-loader spin"></span>Searching..</button>
                    }

                </div>
                <div class="package-toolbar-search">
                    <TextBox @bind-Value="Query" InputChangeType="InputChangeType.OnValueChange" PlaceHolder="Search for a package by Package ID.." SpellCheck="false" />
                </div>
            </div>
        </div>
        @if (PackageClient != null && !loading && loadError != null)
        {
            @* Unreachable Source : spans both columns, since there are no Packages to select *@
            <div class="load-error">
                <span class="load-error-icon fa-regular fa-sharp fa-cloud-slash"></span>
                <span class="load-error-title">Unable to load Packages from @PackageClient.BaseUrl</span>
                <span class="load-error-description">@loadError</span>
                <button class="btn btn-light" @onclick="SearchClicked"><span class="icon fa-solid fa-sharp fa-rotate-right"></span>Try Again</button>
            </div>
        }
        else
        {
            <div class="package-list scroll-panel">

                @if (PackageClient == null)
                {
                    <div class="not-found">
                        <div class="not-found-container">
                            <span class="icon fa-solid fa-sharp fa-signal-slash"></span>
                            <span class="label">No Package Source selected</span>
                        </div>
                    </div>
                }
                else if (!loading)
                {
                    var visiblePackages = GetVisiblePackages();

                    if (!visiblePackages.IsNullOrEmpty())
                    {
                        if (installError != null)
                        {
                            <div class="install-error">
                                <span class="icon fa-solid fa-sharp fa-triangle-exclamation"></span>
                                <span class="install-error-message">@installError</span>
                                <button class="btn btn-sm btn-light" @onclick="() => installError = null">Dismiss</button>
                            </div>
                        }

                        foreach (var package in visiblePackages)
                        {
                            var isSelected = package.Id == selectedId;
                            var installedPackage = GetInstalled(package);
                            var installed = installedPackage != null;
                            var updated = installedPackage != null && (TrakHound.Extensions.VersionComparer.Default.Compare(installedPackage.Version, package.Version) > 0 ||
                                (installedPackage.Version == package.Version && installedPackage.BuildDate.ToUniversalTime() >= package.BuildDate.ToUniversalTime()));
                            var packateInstalling = IsPackageInstalling(package.Id);

                            <PackageInstallItem Package="@package"
                                                IsSelected="@isSelected"
                                                Clicked="ClickPackage"
                                                IsInstalled="@installed"
                                                InstalledVersion="@installedPackage?.Version"
                                                IsInstalling="@packateInstalling"
                                                IsUpdated="@updated"
                                                ManifestCheck="@manifestChecks?.GetValueOrDefault(package.Uuid)"
                                                WouldRefuse="@PackageManager.WouldRefuse(manifestChecks?.GetValueOrDefault(package.Uuid))"
                                                Selected="async () => await InstallPackage(package)"
                                                />
                        }
                    }
                    else if (!queryChanged)
                    {
                        <div class="not-found">
                            <div class="not-found-container">
                                <span class="icon fas fa-ban"></span>

                                @if (!string.IsNullOrEmpty(query))
                                {
                                    <span class="label">No Packages found that match "@query"</span>
                                }
                                else if (!string.IsNullOrEmpty(Category))
                                {
                                    @* As the Category tabs show it (ex. app is App) *@
                                    <span class="label">No @(char.ToUpperInvariant(Category[0]) + Category[1..]) Packages in @PackageClient.Organization</span>
                                }
                                else
                                {
                                    @* The Source answered with an empty list : an Organization with nothing published to it yet *@
                                    <span class="label">No Packages in @PackageClient.Organization yet</span>
                                    <span class="sublabel">Packages published to this Source are listed here</span>
                                }

                            </div>
                        </div>
                    }
                }
                else
                {
                    <Loading Message="Loading Packages.." />
                }

            </div>
            <div class="package-information scroll-panel">
                @if (selectedPackage != null)
                {
                    @* Only shown when the Browser is too narrow for both columns (the details replace the list) *@
                    <div class="information-back">
                        <button class="btn btn-light" @onclick="ClearSelection"><span class="icon fa-solid fa-sharp fa-arrow-left"></span>Back to Packages</button>
                    </div>
                    <PackageInformation Package="@selectedPackage" PackageClient="@PackageClient" PackageManager="@PackageManager" ManifestCheck="@manifestChecks?.GetValueOrDefault(selectedPackage.Uuid)" />
                }
                else
                {
                    <div class="information-placeholder">
                        <span class="icon fa-regular fa-sharp fa-hand-pointer"></span>
                        <span class="label">Select a Package to see its details</span>
                        <span class="sublabel">Versions, dependencies, source and license requirements</span>
                    </div>
                }
            </div>
        }
    </div>
</div>


@code {

    private readonly HashSet<string> packagesInstalling = new HashSet<string>();

    IEnumerable<TrakHoundPackage> packages;
    Dictionary<string, TrakHoundPackageManifestCheck> manifestChecks;
    TrakHoundPackage selectedPackage;
    string selectedId;

    string previousPackageManagerPath;
    string previousPackageClientBaseUrl;
    string previousPackageClientOrganization;
    string previousCategory;

    string query;
    string previousQuery;
    string loadError;
    string installError;
    int loadVersion;
    System.Timers.Timer queryTimer;
    bool loading = false;
    bool queryChanged = false;
    bool disposed = false;

    public string Query
    {
        get => query;
        set
        {
            query = value;
            if (query != previousQuery)
            {
                // All Categories are filtered locally (no Source query needed)
                if (string.IsNullOrEmpty(Category))
                {
                    previousQuery = query;
                    return;
                }

                UpdateTimer();
                previousQuery = query;
                queryChanged = true;
            }
        }
    }

    [Parameter]
    public TrakHoundPackageManager PackageManager { get; set; }

    [Parameter]
    public TrakHoundPackageClient PackageClient { get; set; }

    [Parameter]
    public string Category { get; set; }

    [Parameter]
    public EventCallback<TrakHoundPackage> PackageInstalled { get; set; }

    [Parameter]
    public EventCallback<TrakHoundPackage> PackageUninstalled { get; set; }

    /// <summary>
    /// Installs the Package (and reports the result). When set, it is used instead of the built-in install.
    /// </summary>
    [Parameter]
    public Func<TrakHoundPackage, Task<bool>> InstallHandler { get; set; }


    protected async override Task OnInitializedAsync()
    {
        queryTimer = new System.Timers.Timer();
        queryTimer.Interval = 1000;
        queryTimer.AutoReset = false; // Debounce : Query once after typing stops (not every second)
        queryTimer.Elapsed += QueryTimerElapsed;

        await Load();
    }

    void IDisposable.Dispose()
    {
        disposed = true;

        if (queryTimer != null)
        {
            queryTimer.Elapsed -= QueryTimerElapsed;
            queryTimer.Dispose();
        }
    }

    private async void QueryTimerElapsed(object sender, System.Timers.ElapsedEventArgs args)
    {
        if (disposed) return;

        try
        {
            await Load(true);
        }
        catch (ObjectDisposedException) { } // Component or Circuit disposed during the Query
        catch (Exception) { } // Load reports its own errors (an exception here must not crash the process)
    }

    protected async override Task OnParametersSetAsync()
    {
        await Load();
    }

    private void UpdateTimer()
    {
        if (queryTimer == null || disposed) return;

        queryTimer.Stop();
        queryTimer.Start();
    }

    private async Task SearchClicked()
    {
        await Load(true);
    }

    private async Task Load(bool forceReload = false)
    {
        if (PackageClient == null || PackageManager == null)
        {
            packages = null;
            return;
        }

        if (forceReload ||
            (PackageManager != null && PackageManager.Path != previousPackageManagerPath) ||
            (PackageClient != null && (PackageClient.BaseUrl != previousPackageClientBaseUrl ||
            PackageClient.Organization != previousPackageClientOrganization)) ||
            Category != previousCategory)
        {
            previousPackageManagerPath = PackageManager.Path;
            previousPackageClientBaseUrl = PackageClient.BaseUrl;
            previousPackageClientOrganization = PackageClient.Organization;
            previousCategory = Category;

            selectedId = null;
            selectedPackage = null;
            queryChanged = false;

            loading = true;
            await InvokeAsync(StateHasChanged);

            // This Load uses the current Query, so a pending debounced Query is no longer needed
            if (!disposed) queryTimer.Stop();

            // Only the latest Load applies its result (an older, slower Query must not overwrite a newer one)
            var version = System.Threading.Interlocked.Increment(ref loadVersion);
            var packageClient = PackageClient;
            var category = Category;
            var q = query;

            _ = Task.Run(async () =>
            {
                IEnumerable<TrakHoundPackage> result = null;
                string error = null;

                try
                {
                    if (!string.IsNullOrEmpty(category))
                    {
                        result = await packageClient.Query(category, q);
                    }
                    else
                    {
                        // All Categories (the Search is applied by GetVisiblePackages)
                        result = await packageClient.QueryLatestByOrganization();
                    }

                    // A Source with no Packages answers with an empty list, so null means it didn't answer (or answered with an error)
                    if (result == null) error = "The Source didn't respond. Check its Base URL, and that this Instance can reach it";
                    result = result?.OrderByDescending(o => o.BuildDate).ToList();
                }
                catch (Exception ex)
                {
                    result = null;
                    error = ex.Message;
                }

                if (disposed || version != System.Threading.Volatile.Read(ref loadVersion)) return;

                try
                {
                    await InvokeAsync(() =>
                    {
                        if (version != loadVersion) return;

                        packages = result;
                        manifestChecks = null;
                        loadError = error;
                        loading = false;
                        StateHasChanged();
                    });

                    await LoadManifests(packageClient, result, version);
                }
                catch (ObjectDisposedException) { } // Component or Circuit disposed during the Query
            });
        }
    }

    /// <summary>
    /// Check who signed the listed Packages after the list is shown, so that a slow Source doesn't hold it up. A Source without Manifests shows no badges
    /// </summary>
    private async Task LoadManifests(TrakHoundPackageClient packageClient, IEnumerable<TrakHoundPackage> listed, int version)
    {
        if (listed.IsNullOrEmpty()) return;

        Dictionary<string, TrakHoundPackageManifestCheck> checks = null;
        try
        {
            var manifests = await packageClient.GetManifests(listed.Select(o => o.Uuid));
            if (manifests != null) checks = PackageManager.CheckManifests(listed, manifests);
        }
        catch { } // The badges are optional, and Check Package still works

        if (checks == null || disposed || version != System.Threading.Volatile.Read(ref loadVersion)) return;

        await InvokeAsync(() =>
        {
            if (version != loadVersion) return;

            manifestChecks = checks;
            StateHasChanged();
        });
    }

    private IEnumerable<TrakHoundPackage> GetVisiblePackages()
    {
        if (packages == null || string.IsNullOrWhiteSpace(query) || !string.IsNullOrEmpty(Category)) return packages;

        // Category queries are searched by the Source. The latest Packages (All Categories) are filtered here.
        var q = query.Trim();
        return packages.Where(o => o.Id.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (o.Metadata?.Any(m => string.Equals(m.Key, TrakHoundPackage.DescriptionName, StringComparison.OrdinalIgnoreCase) && (m.Value?.ToString()?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)) ?? false));
    }

    private void ClickPackage(string packageId)
    {
        selectedId = packageId;
        if (!packages.IsNullOrEmpty())
        {
            selectedPackage = packages.FirstOrDefault(o => o.Id == packageId);
        }
    }

    private void ClearSelection()
    {
        selectedId = null;
        selectedPackage = null;
    }

    /// <summary>
    /// The installed Package the listed one is compared with : the same Version if it is installed, else the newest installed Version
    /// (Prereleases included, since GetLatest prefers a Stable Version and an installed newer Prerelease would be offered as an Update again)
    /// </summary>
    private TrakHoundPackage GetInstalled(TrakHoundPackage package)
    {
        return PackageManager.Get(package.Id, package.Version) ??
            PackageManager.Resolve(package.Id, TrakHoundPackage.WilcardVersion + TrakHoundPackage.PrereleaseWildcardSuffix);
    }

    private bool IsPackageInstalling(string packageId)
    {
        return packagesInstalling.Contains(packageId);
    }


    private async Task InstallPackage(TrakHoundPackage package)
    {
        if (package != null && InstallHandler != null)
        {
            installError = null;
            packagesInstalling.Add(package.Id);
            await InvokeAsync(StateHasChanged);

            try
            {
                await InstallHandler(package);
            }
            catch (Exception ex)
            {
                installError = $"Unable to install {package.Id} {package.Version} : {ex.Message}";
            }
            finally
            {
                packagesInstalling.Remove(package.Id);
                await InvokeAsync(StateHasChanged);
            }
        }
        else if (package != null)
        {
            installError = null;
            packagesInstalling.Add(package.Id);
            await InvokeAsync(StateHasChanged);

            _ = Task.Run(async () =>
            {
                string error = null;

                try
                {
                    // Download Package
                    var packageBytes = await PackageClient.Download(package.Id, package.Version);
                    if (packageBytes != null)
                    {
                        // Install using PackageManager
                        TrakHound.Instance.Pages.Packages.PackagesContext.DemandInstall(packageBytes);
                        var results = await PackageManager.Install(packageBytes, packageClient: PackageClient);
                        if (!results.IsNullOrEmpty())
                        {
                            foreach (var result in results)
                            {
                                if (result.Success)
                                {
                                    var installedPackage = PackageManager.Get(result.PackageId, result.PackageVersion);
                                    if (installedPackage != null)
                                    {
                                        await InvokeAsync(async () =>
                                        {
                                            await PackageInstalled.InvokeAsync(installedPackage);
                                        });
                                    }
                                }
                                else
                                {
                                    error = $"Unable to install {result.PackageId} {result.PackageVersion} : {result.Message}";
                                }
                            }
                        }
                    }
                    else
                    {
                        error = $"Unable to download {package.Id} {package.Version}";
                    }
                }
                catch (Exception ex)
                {
                    error = $"Unable to install {package.Id} {package.Version} : {ex.Message}";
                }
                finally
                {
                    // Always clear the Installing state (or the item would spin forever)
                    if (!disposed)
                    {
                        try
                        {
                            await InvokeAsync(() =>
                            {
                                packagesInstalling.Remove(package.Id);
                                if (error != null) installError = error;
                                StateHasChanged();
                            });
                        }
                        catch (ObjectDisposedException) { } // Component or Circuit disposed during the Install
                    }
                }
            });
        }
    }

}
