@* The markup and behavior live in TextBox; this keeps the PasswordBox parameters and the password-box look *@
<TextBox RootClass="password-box"
         InputType="password"
         Enabled="@Enabled"
         Title="@Title"
         SubTitle="@SubTitle"
         Value="@Value"
         ValueChanged="@ValueChanged"
         Submitted="@Submitted"
         Prefix="@Prefix"
         Suffix="@Suffix"
         Message="@Message"
         PlaceHolder="@PlaceHolder"
         ElementId="@ElementId"
         InputElementId="@InputElementId"
         InputName="@InputName"
         InputChangeType="@InputChangeType"
         Class="@Class"
         SpellCheck="false"
         AutoComplete="@AutoComplete"
         TabIndex="@TabIndex"
         Size="@Size" />


@code {

    [Parameter]
    public bool Enabled { get; set; } = true;

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string SubTitle { get; set; }

    [Parameter]
    public string Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> Submitted { get; set; }

    [Parameter]
    public string Prefix { get; set; }

    [Parameter]
    public string Suffix { get; set; }

    [Parameter]
    public string Message { get; set; }

    [Parameter]
    public string PlaceHolder { get; set; }

    [Parameter]
    public string ElementId { get; set; }

    [Parameter]
    public string InputElementId { get; set; }

    [Parameter]
    public string InputName { get; set; }

    [Parameter]
    public InputChangeType InputChangeType { get; set; }

    [Parameter]
    public string Class { get; set; }

    // Sign-in forms pass "current-password" so password managers can fill them
    [Parameter]
    public string AutoComplete { get; set; } = "off";

    // Null leaves tabindex off the input so it keeps its natural place in the Tab order
    [Parameter]
    public int? TabIndex { get; set; }

    [Parameter]
    public Size Size { get; set; }

}
