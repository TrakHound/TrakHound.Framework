<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath and arguments are set when Published. Only the In-Process Hosting Model is supported -->
      <!-- startupTimeLimit allows for Packages to be loaded before the HTTP server Starts -->
      <!-- stdoutLogEnabled keeps the Instance's console output, including what the runtime writes when it crashes (ex. a Stack Overflow), which the Instance shows after the crash. Each process start creates a new file, so delete old ones -->
      <aspNetCore hostingModel="inprocess" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" startupTimeLimit="300">
        <!-- The Installer sets TRAKHOUND_CONFIGURATION_PATH, TRAKHOUND_PACKAGE_PATH, and TRAKHOUND_VOLUME_PATH when installed for IIS -->
        <environmentVariables>
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Allow large uploads (ex. Packages). The IIS default is 30 MB -->
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
