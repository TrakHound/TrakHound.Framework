<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<TargetFramework>$(TrakHoundTargetFramework)</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<TargetFramework>$(TrakHoundTargetFramework)</TargetFramework>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TrakHound.Hosting.AspNetCore</AssemblyName>
		<RootNamespace>TrakHound.Hosting</RootNamespace>
		<Configurations>Debug;Release;Package</Configurations>
		<Description>Contains classes for hosting TrakHound Apis in ASP.NET Core outside of an Instance (ex. mapping the Endpoints and Streams of the Controllers)</Description>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TrakHound.Common\TrakHound.Common.csproj" />
		<ProjectReference Include="..\TrakHound.AspNetCore\TrakHound.AspNetCore.csproj" />
		<ProjectReference Include="..\TrakHound.Hosting\TrakHound.Hosting.csproj" />
	</ItemGroup>

</Project>
