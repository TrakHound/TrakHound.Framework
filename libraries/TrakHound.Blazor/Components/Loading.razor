@{
    var delay = Delay ? "delay" : "";
}

<div class="loading @delay">
    <div class="loading-container">
        <svg class="loading-icon spin" width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 1.5v3M8 11.5v3M1.5 8h3M11.5 8h3M3.4 3.4l2.1 2.1M10.5 10.5l2.1 2.1M3.4 12.6l2.1-2.1M10.5 5.5l2.1-2.1" /></svg>
        <span class="loading-message">@Message</span>
    </div>
</div>

@code {

    [Parameter]
    public string Message { get; set; }

    [Parameter]
    public bool Delay { get; set; } = true;

}
