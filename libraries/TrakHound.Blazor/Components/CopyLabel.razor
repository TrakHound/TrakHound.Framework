@inject JavascriptService javascriptService
@using TrakHound.Blazor.Services

<div class="copy-label">

    @if (!string.IsNullOrEmpty(Link))
    {
        <a href="@Link"><label>@Value</label></a>
    }
    else
    {
        <label>@Value</label>
    }

    <button class="btn btn-link" title="Copy" @onclick="Copy"><svg class="icon" width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="9" height="9" rx="1" /><path d="M10.5 3V2.5a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1H3" /></svg></button>
</div>

@code {

    [Parameter]
    public string Value { get; set; }

    [Parameter]
    public string Link { get; set; }

    [Parameter]
    public EventCallback<string> CopyClicked { get; set; }


    private async void Copy()
    {
        await javascriptService.CopyClipboard(Value);
        await CopyClicked.InvokeAsync(Value);
    }

}
