<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<TargetFrameworks>$(TrakHoundTargetFramework)</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<TargetFrameworks>$(TrakHoundTargetFramework)</TargetFrameworks>
		<RuntimeIdentifiers>win-x64;win-x86;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TrakHound.Blazor.Hosting</AssemblyName>
		<RootNamespace>TrakHound.Blazor</RootNamespace>
		<Configurations>Debug;Release;Package</Configurations>
		<Description>Contains classes for implementing .NET Blazor Hosting in the TrakHound Framework</Description>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <_ContentIncludedByDefault Remove="wwwroot\js\trakhound-blazor.js" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- The TrakHound stylesheet: the files in Styles are joined, in this order, into wwwroot/css/trakhound/trakhound.css
	     on every build (a later rule wins over an earlier one with the same specificity). The output isn't committed -->
	<PropertyGroup>
		<TrakHoundStylesheetOutput>wwwroot\css\trakhound\trakhound.css</TrakHoundStylesheetOutput>
	</PropertyGroup>

	<ItemGroup>
		<TrakHoundStylesheet Include="Styles\base.css" />
		<TrakHoundStylesheet Include="Styles\colors.css" />
		<TrakHoundStylesheet Include="Styles\buttons\command.css" />
		<TrakHoundStylesheet Include="Styles\buttons\light.css" />
		<TrakHoundStylesheet Include="Styles\buttons\link.css" />
		<TrakHoundStylesheet Include="Styles\buttons\primary.css" />
		<TrakHoundStylesheet Include="Styles\buttons\remove.css" />
		<TrakHoundStylesheet Include="Styles\buttons\secondary.css" />
		<TrakHoundStylesheet Include="Styles\buttons\toolbar.css" />
		<TrakHoundStylesheet Include="Styles\buttons\icons.css" />
		<TrakHoundStylesheet Include="Styles\layout.css" />
		<TrakHoundStylesheet Include="Styles\tables.css" />
		<TrakHoundStylesheet Include="Styles\radzen.css" />
		<TrakHoundStylesheet Include="Styles\forms.css" />
		<TrakHoundStylesheet Include="Styles\reconnection.css" />
		<TrakHoundStylesheet Include="Styles\global.css" />
	</ItemGroup>

	<UsingTask TaskName="JoinTrakHoundStylesheet" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs">
				<![CDATA[
				var parts = Files.Select(o => "/* " + o.ItemSpec.Replace('\\', '/') + " */\n\n" + File.ReadAllText(o.ItemSpec).Replace("\r\n", "\n").Trim());
				var text = "/* Generated by the build from the files in Styles (TrakHound.Blazor.Hosting.csproj). Edit those, not this file */\n\n\n" + string.Join("\n\n\n", parts) + "\n";

				// Only written when it changes, so an unchanged stylesheet doesn't trigger a rebuild of what depends on it
				if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text) File.WriteAllText(OutputFile, text);
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="BuildTrakHoundStylesheet" BeforeTargets="BeforeBuild">
		<JoinTrakHoundStylesheet Files="@(TrakHoundStylesheet)" OutputFile="$(TrakHoundStylesheetOutput)" />

		<!-- After a clean checkout the file didn't exist when wwwroot was globbed, so it's added to the static web assets here -->
		<ItemGroup>
			<Content Include="$(TrakHoundStylesheetOutput)" Exclude="@(Content)" />
		</ItemGroup>
	</Target>

	<!-- Font Awesome Pro is licensed, so it's never packed. Official Instance builds supply it (the Builder copies it to wwwroot/css/font-awesome,
	     which is ignored by git). Without it, TrakHoundIconAssets loads a placeholder for the icons.
	     'dotnet pack' sets _IsPacking, and CheckFontAwesomeNotPacked catches a pack that still includes it (ex. a pack that skips the build, after a build with it) -->
	<PropertyGroup Condition="'$(_IsPacking)'=='true'">
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\css\font-awesome\**</DefaultItemExcludes>
	</PropertyGroup>

	<UsingTask TaskName="CheckTrakHoundPackageExcludes" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<PackageFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<ExcludedPath ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
				foreach (var PackageFile in PackageFiles.Select(o => o.GetMetadata("FullPath")).Where(o => o.EndsWith(".nupkg", StringComparison.OrdinalIgnoreCase) && File.Exists(o)))
				{
					bool found;
					using (var zip = ZipFile.OpenRead(PackageFile))
					{
						found = zip.Entries.Any(o => o.FullName.Replace('\\', '/').IndexOf(ExcludedPath, StringComparison.OrdinalIgnoreCase) >= 0);
					}

					if (found)
					{
						// Deleted so it can't be published by mistake
						File.Delete(PackageFile);
						Log.LogError("'" + ExcludedPath + "' is licensed and must not be packed, so " + PackageFile + " was deleted. Pack again without --no-build");
					}
				}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="CheckFontAwesomeNotPacked" AfterTargets="Pack">
		<CheckTrakHoundPackageExcludes PackageFiles="@(NuGetPackOutput)" ExcludedPath="css/font-awesome/" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Blazored.SessionStorage" Version="2.4.0" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<!--<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.10" />-->
		<PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
		<PackageReference Include="Radzen.Blazor" Version="11.2.0" />
		<PackageReference Include="Markdig" Version="0.38.0" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TrakHound.Blazor\TrakHound.Blazor.csproj" />
	</ItemGroup>

</Project>
