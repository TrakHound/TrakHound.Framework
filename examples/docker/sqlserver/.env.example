# Copy to .env (next to docker-compose.yml) and set SQLSERVER_PASSWORD. Docker Compose reads it on every command
INSTANCE_NAME=trakhound-sqlserver
INSTANCE_PORT=8472
INSTANCE_DESCRIPTION=SQL Server example
# Required : the 'sa' login's password, set when the server is first created (a new volume). At least 8 characters, with three
# of: upper case, lower case, digits and symbols
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=trakhound
SQLSERVER_PORT=1433
# Developer (free, not for production), Express (free, with limits) or a paid edition you have a license for
SQLSERVER_EDITION=Developer
