<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(TrakHoundTargetFramework)</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<!-- The Reading model, shared with the other examples -->
		<Compile Include="..\TrakHound.Example.Worker\SensorReading.cs" Link="SensorReading.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\libraries\TrakHound.Common\TrakHound.Common.csproj" />
	</ItemGroup>

	<!-- The debug host (Program.cs). th packages dotnet removes these when it builds the package -->
	<ItemGroup Label="references-trakhound-debug">
		<ProjectReference Include="..\..\debug\TrakHound.Debug\TrakHound.Debug.csproj" />
	</ItemGroup>

	<ItemGroup Label="files-trakhound-debug">
		<None Update="trakhound.debug.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="trakhound.package.json" />
	  <Content Remove="trakhound.package.publish.json" />
	  <None Include="trakhound.package.json" />
	  <None Include="trakhound.package.publish.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md" CopyToOutputDirectory="Always" />
	</ItemGroup>

</Project>
