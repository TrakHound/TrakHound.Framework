# Ignore Visual Studio files
.vs/
.config/

# Ignore .NET Build files
[Bb]in/
[Oo]bj/

# Ignore Nuget Build files
[Bb]uild/[Oo]utput

# Ignore Properties files (except the launch profiles of the templates and the Api modules, which open the Api Debugger)
[Pp]roperties/
!templates/**/content/**/[Pp]roperties/
!modules/*.Api/[Pp]roperties/
!examples/*.Api/[Pp]roperties/

# Ignore the Volume the examples share when debugging (volumePath in their trakhound.debug.json)
examples/volume/

# Ignore Package Publish Targets (where each developer publishes to is set locally)
*.package.publish.json
!templates/**/content/**/trakhound.package.publish.json

# Ignore built Packages
*.thp

# Ignore Environment files
trakhound-environment.config.yaml

# Ignore Template build .exe and .zip
[Tt]emplates/**/*.exe
[Tt]emplates/**/*.zip

# Ignore Configuration files
instance.config.yaml
remotes.config.yaml

# Ignore FontAwesome (licensed version)
libraries/TrakHound.Blazor.Hosting/wwwroot/css/font-awesome/

# Ignore the TrakHound stylesheet (generated by the build from libraries/TrakHound.Blazor.Hosting/Styles)
libraries/TrakHound.Blazor.Hosting/wwwroot/css/trakhound/trakhound.css

# Ignore local Claude Code files (launch.json and settings.json are shared)
.claude/settings.local.json
.claude/worktrees/

# Ignore user-specific project files
*.user
