{
  "$schema": "http://json.schemastore.org/template",
  "author": "TrakHound Inc.",
  "classifications": [
    "Common",
    "Function"
  ],
  "identity": "TrakHound.Function.Template",
  "name": "TrakHound Function",
  "description": "Template to create a TrakHound Function Project",
  "shortName": "trakhound.function",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "UserPackageId",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(managementServer == \"\" && organization == \"\")",
          "exclude": [ "trakhound.package.publish.json" ]
        }
      ]
    }
  ],
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Skips restoring the project's NuGet packages after it is created",
      "defaultValue": "false"
    },
    "trakhoundVersion": {
      "type": "parameter",
      "description": "Version of the TrakHound NuGet packages to reference. Use the TrakHound version of the Instance you deploy to (or older)",
      "replaces": "{trakhoundVersion}",
      "defaultValue": "*-*"
    },
    "instanceUrl": {
      "type": "parameter",
      "description": "The URL of the Instance the debug host connects to",
      "replaces": "{instanceUrl}",
      "defaultValue": "http://localhost:8472"
    },
    "publisher": {
      "type": "parameter",
      "description": "The publisher metadata in trakhound.package.json",
      "replaces": "{publisher}",
      "defaultValue": ""
    },
    "description": {
      "type": "parameter",
      "description": "The description metadata in trakhound.package.json",
      "replaces": "{description}",
      "defaultValue": ""
    },
    "managementServer": {
      "type": "parameter",
      "description": "The Package Server of the default Publish Target in trakhound.package.publish.json (the file is only created if this or organization is set)",
      "replaces": "{managementServer}",
      "defaultValue": ""
    },
    "organization": {
      "type": "parameter",
      "description": "The Organization of the default Publish Target in trakhound.package.publish.json (the file is only created if this or managementServer is set)",
      "replaces": "{organization}",
      "defaultValue": ""
    }
  },
  "primaryOutputs": [
    {
      "path": "UserPackageId.csproj"
    },
    {
      "path": "Function.cs"
    },
    {
      "path": "trakhound.package.json"
    }
  ],
  "defaultName": "TrakHoundFunction1",
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "id": "open-file",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Opens Function.cs in the editor",
      "manualInstructions": [],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1"
      },
      "continueOnError": true
    }
  ]
}