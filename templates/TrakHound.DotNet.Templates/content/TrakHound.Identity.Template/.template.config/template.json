{
  "$schema": "http://json.schemastore.org/template",
  "author": "TrakHound Inc.",
  "classifications": [
    "Common",
    "Identity"
  ],
  "identity": "TrakHound.Identity.Template",
  "name": "TrakHound Identity",
  "description": "Template to create a TrakHound Identity Project",
  "shortName": "trakhound.identity",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "UserPackageId",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!localTarget && packageServer == \"\" && organization == \"\")",
          "exclude": [ "trakhound.package.publish.json" ]
        },
        {
          "condition": "(HostIdentifier == \"vs\")",
          "exclude": [ ".vscode/**" ]
        }
      ]
    }
  ],
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Skips restoring the project's NuGet packages after it is created",
      "defaultValue": "false"
    },
    "trakhoundVersion": {
      "type": "parameter",
      "description": "Version of the TrakHound NuGet packages to reference. Use the TrakHound version of the Instance you deploy to (or older)",
      "replaces": "{trakhoundVersion}",
      "defaultValue": "*-*"
    },
    "instanceUrl": {
      "type": "parameter",
      "description": "The URL of the Instance the debug host connects to",
      "replaces": "{instanceUrl}",
      "defaultValue": "http://localhost:8472"
    },
    "publisher": {
      "type": "parameter",
      "description": "The publisher metadata in trakhound.package.json",
      "replaces": "{publisher}",
      "defaultValue": ""
    },
    "description": {
      "type": "parameter",
      "description": "The description metadata in trakhound.package.json",
      "replaces": "{description}",
      "defaultValue": ""
    },
    "localTarget": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Adds the 'local' Publish Target to trakhound.package.publish.json : the Dev Package Server of the development Instance at instanceUrl (ex. trakhound/instance-dev). Set it to false in a repository that has a shared trakhound.package.publish.json (without packageServer or organization, the file is then left out)",
      "defaultValue": "true"
    },
    "packageServer": {
      "type": "parameter",
      "description": "The Package Server of the 'default' Publish Target in trakhound.package.publish.json, which is then the defaultTarget",
      "replaces": "{packageServer}",
      "defaultValue": ""
    },
    "organization": {
      "type": "parameter",
      "description": "The Organization of the 'default' Publish Target in trakhound.package.publish.json, which is then the defaultTarget",
      "replaces": "{organization}",
      "defaultValue": ""
    }
  },
  "primaryOutputs": [
    {
      "path": "UserPackageId.csproj"
    },
    {
      "path": "Module.cs"
    },
    {
      "path": "trakhound.package.json"
    }
  ],
  "defaultName": "TrakHoundIdentity1",
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "args": {
        "files": [ "UserPackageId.csproj" ]
      },
      "continueOnError": true
    },
    {
      "id": "open-file",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Opens Module.cs in the editor",
      "manualInstructions": [],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1"
      },
      "continueOnError": true
    }
  ]
}