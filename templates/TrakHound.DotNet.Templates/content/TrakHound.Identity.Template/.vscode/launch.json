{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug host (Authenticate a token)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/UserPackageId.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "launchSettingsProfile": "UserPackageId (Authenticate a token)"
    },
    {
      "name": "Debug host (Authenticate without a token)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/UserPackageId.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "launchSettingsProfile": "UserPackageId (Authenticate without a token)"
    },
    {
      "name": "Attach to Instance",
      "type": "coreclr",
      "request": "attach",
      "processName": "TrakHound.Instance"
    }
  ]
}
