{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug host",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/UserPackageId.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach to Instance",
      "type": "coreclr",
      "request": "attach",
      "processName": "TrakHound.Instance"
    }
  ]
}
