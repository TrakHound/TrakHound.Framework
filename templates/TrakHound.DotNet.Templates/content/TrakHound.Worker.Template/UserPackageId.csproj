<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TrakHound.Common" Version="{trakhoundVersion}" />
	</ItemGroup>

	<!-- The debug host (Program.cs). th packages dotnet removes these when it builds the package -->
	<ItemGroup Label="references-trakhound-debug">
		<PackageReference Include="TrakHound.Debug" Version="{trakhoundVersion}" />
	</ItemGroup>

	<ItemGroup Label="files-trakhound-debug">
		<None Update="trakhound.debug.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="trakhound.package.json" />
	  <Content Remove="trakhound.package.publish.json" />
	  <None Include="trakhound.package.json" />
	  <None Include="trakhound.package.publish.json" />
	</ItemGroup>

</Project>
