<!--#if (isApi) -->
<Project Sdk="Microsoft.NET.Sdk.Web">
<!--#else -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
<!--#endif -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!-- The package the host runs (built into the host, so the package project doesn't change) -->
	<ItemGroup>
		<ProjectReference Include="..\UserModuleId\UserModuleId.csproj" />
	</ItemGroup>

	<ItemGroup>
<!--#if (isApi) -->
		<PackageReference Include="TrakHound.Hosting.AspNetCore" Version="{trakhoundVersion}" />
<!--#else -->
		<PackageReference Include="TrakHound.Hosting" Version="{trakhoundVersion}" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
<!--#endif -->
<!--#if (!isFunction) -->
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
<!--#endif -->
	</ItemGroup>
<!--#if (isApi) -->

	<!-- The package's information names and versions the OpenAPI document -->
	<ItemGroup>
		<None Include="..\UserModuleId\trakhound.package.json" Link="trakhound.package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="..\UserModuleId\trakhound.package.publish.json" Link="trakhound.package.publish.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\UserModuleId\trakhound.package.publish.json')" />
	</ItemGroup>
<!--#endif -->

</Project>
