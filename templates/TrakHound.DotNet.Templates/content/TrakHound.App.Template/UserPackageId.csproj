<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TrakHound.Debug.Apps" Version="{trakhoundVersion}" />
	</ItemGroup>

	<!-- Settings for the debug host (Program.cs). th packages dotnet removes this when it builds the package -->
	<ItemGroup Label="files-trakhound-debug">
		<Content Update="trakhound.debug.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="trakhound.package.json" />
	  <Content Remove="trakhound.package.publish.json" />
	  <None Include="trakhound.package.json" />
	  <None Include="trakhound.package.publish.json" />
	</ItemGroup>

</Project>
