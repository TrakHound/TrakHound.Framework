# Copy to .env (next to docker-compose.yml) and set POSTGRES_PASSWORD. Docker Compose reads it on every command
INSTANCE_NAME=trakhound-plant
INSTANCE_DESCRIPTION=Plant example
# Required : the password of the database login, set when the database is first created (a new volume)
POSTGRES_PASSWORD=
# Caddy : 'localhost', or a domain name that points to this machine (with ports 80 and 443 open to the internet, for Let's Encrypt)
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Seconds between the simulated machines' readings
SIMULATOR_INTERVAL=1
# Ports on this machine for tools (ex. MQTT Explorer, psql)
MQTT_PORT=1883
POSTGRES_PORT=5432
