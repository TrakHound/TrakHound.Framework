# Copy to .env (next to docker-compose.yml) and set POSTGRES_PASSWORD. Docker Compose reads it on every command
INSTANCE_NAME=trakhound-postgres
INSTANCE_PORT=8472
INSTANCE_DESCRIPTION=PostgreSQL and TimescaleDB example
# Required : the password of the database login, set when the database is first created (a new volume)
POSTGRES_PASSWORD=
POSTGRES_USER=trakhound
POSTGRES_DATABASE=trakhound
POSTGRES_PORT=5432
# postgres:17 for PostgreSQL alone (Tables only)
POSTGRES_IMAGE=timescale/timescaledb:latest-pg17
