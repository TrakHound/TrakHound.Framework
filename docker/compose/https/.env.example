# Copy to .env (next to docker-compose.yml) to change these. Docker Compose reads it on every command
INSTANCE_NAME=trakhound-https
INSTANCE_DESCRIPTION=HTTPS example
# 'localhost', or a domain name that points to this machine (with ports 80 and 443 open to the internet, for Let's Encrypt)
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
